    z-index: 1030;
  }
  
  .nav-link-modern {
    position: relative;
    color: #475569 !important;
    font-weight: 500;
    transition: color 0.3s ease;
    padding-left: 0.5rem !important;
    padding-right: 0.5rem !important;
    margin: 0 0.25rem;
  }
  .nav-link-modern:hover { color: #2563eb !important; }
  .nav-link-modern::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0px;
    left: 50%;
    transform: translateX(-50%);
