<!-- Bazaar Selection Modal -->
<div class="modal fade" id="bazaarModal" tabindex="-1" aria-labelledby="bazaarModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content" style="border-radius: 1rem; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark" id="bazaarModalLabel"><i class="fa-solid fa-location-dot text-danger me-2"></i>Select Local Bazaar</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3 position-relative">
          <input type="text" id="bazaarSearchInput" class="form-control" placeholder="Search bazaars..." style="border-radius: 99px; padding-left: 2.5rem; border-color: #cbd5e1;">
          <i class="fa-solid fa-search position-absolute text-muted" style="left: 1rem; top: 50%; transform: translateY(-50%);"></i>
        </div>
        <button type="button" class="btn btn-primary w-100 mb-3" style="border-radius: 99px; font-weight: 600;" onclick="useCurrentLocation()">
          <i class="fa-solid fa-location-crosshairs me-2"></i>Use Current Location
        </button>
        <div class="list-group list-group-flush" id="bazaarList">
          <div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm" role="status"></div> Loading bazaars...</div>
        </div>
      </div>
      <div class="modal-footer border-top-0 pt-0 justify-content-start">
        <button type="button" class="btn btn-outline-danger w-100" style="border-radius: 99px; font-weight: 600;" onclick="selectBazaar('')">
          <i class="fa-solid fa-earth-americas me-2"></i>Show All Bazaars (Clear)
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let bazaarsCache = [];
  const bazaarModalEl = document.getElementById('bazaarModal');
  let bsBazaarModal = null;
  
  if (bazaarModalEl) {
    if (typeof bootstrap !== 'undefined') {
      bsBazaarModal = new bootstrap.Modal(bazaarModalEl);
    }
    
    bazaarModalEl.addEventListener('show.bs.modal', async () => {
      await fetchBazaars();
    });

    document.getElementById('bazaarSearchInput').addEventListener('input', (e) => {
      renderBazaars(e.target.value);
    });
  }

  // Auto-prompt on first visit
  document.addEventListener('DOMContentLoaded', () => {
    const hasBazaar = "<%= typeof bazaarName !== 'undefined' ? bazaarName : '' %>";
    const prompted = localStorage.getItem('bazaarPrompted');
    
    if (!hasBazaar && !prompted && bsBazaarModal) {
      bsBazaarModal.show();
      localStorage.setItem('bazaarPrompted', 'true');
    }
  });

  async function fetchBazaars() {
    try {
      const res = await fetch('/api/bazaars');
      const data = await res.json();
      if (data.success) {
        bazaarsCache = data.bazaars;
        renderBazaars();
      }
    } catch (e) {
      console.error('Failed to fetch bazaars', e);
      document.getElementById('bazaarList').innerHTML = '<div class="text-center text-danger py-4">Failed to load bazaars.</div>';
    }
  }

  function renderBazaars(query = '') {
    const list = document.getElementById('bazaarList');
    let filtered = bazaarsCache;
    if (query.trim() !== '') {
      const q = query.toLowerCase();
      filtered = bazaarsCache.filter(b => b.name.toLowerCase().includes(q));
    }

    if (filtered.length === 0) {
      list.innerHTML = '<div class="text-center text-muted py-4">No bazaars found.</div>';
      return;
    }

    list.innerHTML = filtered.map(b => `
      <button type="button" class="list-group-item list-group-item-action border-0 mb-1 rounded d-flex align-items-center" onclick="selectBazaar('${b._id}')">
        <div class="bg-light rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
          <i class="fa-solid fa-shop text-primary"></i>
        </div>
        <div>
          <h6 class="mb-0 fw-bold">${b.name}</h6>
          <small class="text-muted">${b.location}</small>
        </div>
      </button>
    `).join('');
  }

  async function selectBazaar(id) {
    try {
      const res = await fetch('/api/bazaars/select', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bazaarId: id })
      });
      if (res.ok) {
        window.location.reload();
      }
    } catch (e) {
      console.error('Error selecting bazaar', e);
    }
  }

  function useCurrentLocation() {
    if (navigator.geolocation) {
      const btn = event.currentTarget;
      const ogHtml = btn.innerHTML;
      btn.innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div> Finding nearest bazaar...';
      btn.disabled = true;

      navigator.geolocation.getCurrentPosition(
        async (position) => {
          try {
            const res = await fetch('/api/bazaars');
            const data = await res.json();
            if (data.success && data.bazaars.length > 0) {
              // Basic distance calculation
              const lat1 = position.coords.latitude;
              const lon1 = position.coords.longitude;
              
              let closest = null;
              let minD = Infinity;

              data.bazaars.forEach(b => {
                const lat2 = b.geometry.coordinates[1];
                const lon2 = b.geometry.coordinates[0];
                const d = Math.sqrt(Math.pow(lat1 - lat2, 2) + Math.pow(lon1 - lon2, 2));
                if (d < minD) {
                  minD = d;
                  closest = b;
                }
              });

              if (closest) {
                await selectBazaar(closest._id);
              }
            }
          } catch (e) {
            console.error(e);
            btn.innerHTML = ogHtml;
            btn.disabled = false;
            alert("Failed to find nearest bazaar.");
          }
        },
        (error) => {
          console.error(error);
          btn.innerHTML = ogHtml;
          btn.disabled = false;
          alert("Location access denied or failed.");
        }
      );
    } else {
      alert("Geolocation is not supported by this browser.");
    }
  }
</script>

