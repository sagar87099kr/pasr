    <div class="modal-content" style="border-radius: 1rem; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark" id="profileCompletionModalLabel">Complete Your Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-2">
        <p class="text-muted small mb-4">Please provide a few more details to continue with this action.</p>
        <form id="profileCompletionForm">
          <div class="mb-3">
            <label class="form-label fw-bold">Full Name *</label>
            <input type="text" class="form-control" id="pcName" required placeholder="Enter your full name">
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Full Address *</label>
            <textarea class="form-control" id="pcAddress" required rows="2" placeholder="Start typing your address..."></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Additional Phone (Optional)</label>
            <input type="number" class="form-control" id="pcAdditionalPhone" placeholder="Alternate contact number">
          </div>
          <button type="submit" class="btn btn-primary w-100" style="border-radius: 99px; font-weight: 600;" id="pcSubmitBtn">
            Save & Continue
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  let pcPendingCallback = null;
  const userProfileName = "<%= (typeof currUser !== 'undefined' && currUser) ? (currUser.name || '') : '' %>";
  const userProfileAddress = "<%= (typeof currUser !== 'undefined' && currUser) ? (currUser.address || '') : '' %>";
  const isLoggedIn = <%= (typeof currUser !== 'undefined' && currUser) ? 'true' : 'false' %>;

  function requireProfileCompletion(callback) {
    if (!isLoggedIn) {
      window.location.href = '/login';
      return;
    }
    
    // Check if name and address exist and are not just whitespace
    if (userProfileName.trim() === '' || userProfileAddress.trim() === '') {
      pcPendingCallback = callback;
      const pcModal = new bootstrap.Modal(document.getElementById('profileCompletionModal'));
      pcModal.show();
    } else {
      // Profile is complete
      callback();
    }
  }

  document.getElementById('profileCompletionForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('pcSubmitBtn');
    const name = document.getElementById('pcName').value;
    const address = document.getElementById('pcAddress').value;
    const additionalPhone = document.getElementById('pcAdditionalPhone').value;

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';

    try {
      const res = await fetch('/api/user/complete-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, address, additionalPhone })
      });
      const data = await res.json();
      if (data.success) {
        const modal = bootstrap.Modal.getInstance(document.getElementById('profileCompletionModal'));
        modal.hide();
        // Since we don't want to reload the page and lose their action context (e.g., item in cart),
        // we'll execute the callback directly. Next page load will have the updated info.
        if (pcPendingCallback) {
          pcPendingCallback();
          pcPendingCallback = null;
        }
      } else {
        alert(data.message || 'Failed to update profile');
        btn.disabled = false;
        btn.innerHTML = 'Save & Continue';
      }
    } catch (err) {
      console.error(err);
      alert('An error occurred');
      btn.disabled = false;
      btn.innerHTML = 'Save & Continue';
    }
  });

  // Google Maps Autocomplete for Profile Completion
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof google !== 'undefined' && google.maps && google.maps.places) {
      const input = document.getElementById("pcAddress");
      if (input) {
        new google.maps.places.Autocomplete(input, { strictBounds: false });
      }
    }
  });
</script>