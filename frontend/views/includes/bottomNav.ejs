<!-- Universal Fixed Bottom Navigation Bar - Flutter App Matching -->
<style>
    .pasr-bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 60px;
        background: #ffffff;
        border-top: 1px solid #e2e8f0;
        box-shadow: 0 -3px 12px rgba(0, 0, 0, 0.08);
        z-index: 1020;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
        font-family: 'Outfit', system-ui, -apple-system, sans-serif;
    }

    .pasr-bottom-nav-inner {
        width: 100%;
        max-width: 600px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-around;
    }

    .pasr-bottom-nav-item {
        flex: 1;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        text-decoration: none !important;
        color: #94a3b8;
        transition: color 0.15s ease, transform 0.15s ease;
        cursor: pointer;
        border-radius: 8px;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .pasr-bottom-nav-item:hover {
        color: #1e3a8a;
    }

    .pasr-bottom-nav-icon {
        height: 24px;
        width: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s ease;
    }

    .pasr-bottom-nav-icon svg {
        width: 24px;
        height: 24px;
        display: block;
    }

    /* Icon states */
    .pasr-bottom-nav-icon .nav-icon-active {
        display: none;
    }
    .pasr-bottom-nav-icon .nav-icon-inactive {
        display: block;
    }

    .pasr-bottom-nav-label {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: -0.2px;
        line-height: 1.1;
        transition: font-weight 0.15s ease;
    }

    /* Active State (App Matching #1E3A8A) */
    .pasr-bottom-nav-item.active {
        color: #1e3a8a !important;
    }

    .pasr-bottom-nav-item.active .pasr-bottom-nav-label {
        font-weight: 700;
    }

    .pasr-bottom-nav-item.active .nav-icon-inactive {
        display: none;
    }

    .pasr-bottom-nav-item.active .nav-icon-active {
        display: block;
    }

    .pasr-bottom-nav-item.active .pasr-bottom-nav-icon {
        transform: scale(1.05);
    }
</style>

