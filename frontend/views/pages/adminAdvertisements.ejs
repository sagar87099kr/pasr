<% layout('layoutes/boilerplate') %>

<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px);">
    <div class="card-header bg-transparent border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
        <h3 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-rectangle-ad text-primary me-2"></i>Advertisement Management</h3>
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addAdModal">
            <i class="fa-solid fa-plus me-2"></i> Create Advertisement
        </button>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="border-0 rounded-start">Image</th>
                        <th class="border-0">Title</th>
                        <th class="border-0">Duration</th>
                        <th class="border-0">Status</th>
                        <th class="border-0 rounded-end text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(advertisements && advertisements.length > 0) { %>
                        <% advertisements.forEach(function(ad) { %>
                            <% const isExpired = ad.endTime && new Date(ad.endTime) < new Date(); %>
                            <tr>
                                <td>
                                    <img src="<%= ad.imageUrl %>" alt="<%= ad.title %>" class="rounded shadow-sm" style="width: 80px; height: 50px; object-fit: cover;">
                                </td>
                                <td>
                                    <div class="fw-bold"><%= ad.title %></div>
                                    <small class="text-muted"><%= ad.link ? "Link: " + ad.link : "" %></small>
                                    <br>
                                    <small class="text-muted"><%= ad.phoneNumber ? "Phone: " + ad.phoneNumber : "" %></small>
                                </td>
                                <td>
                                    <small class="text-muted d-block">Start: <%= ad.startTime ? new Date(ad.startTime).toLocaleString() : 'Immediate' %></small>
                                    <small class="text-muted d-block">End: <%= ad.endTime ? new Date(ad.endTime).toLocaleString() : 'Never expires' %></small>
                                </td>
                                <td>
                                    <% if(ad.isActive) { %>
                                        <span class="badge bg-success rounded-pill">Active</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary rounded-pill">Inactive</span>
                                    <% } %>
                                    <% if(isExpired) { %>
                                        <span class="badge bg-danger rounded-pill mt-1 d-block" style="width: fit-content;">Expired</span>
                                    <% } %>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-circle me-1" title="Edit Advertisement" data-bs-toggle="modal" data-bs-target="#editAdModal_<%= ad._id %>">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                    <form action="/admin/advertisements/<%= ad._id %>/toggle-active" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-circle me-1" title="Toggle Status">
                                            <i class="fa-solid fa-power-off"></i>
                                        </button>
                                    </form>
                                    <form action="/admin/advertisements/<%= ad._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this advertisement? The image will also be deleted from Cloudinary.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            <!-- Edit Ad Modal for <%= ad._id %> -->
                            <div class="modal fade text-start" id="editAdModal_<%= ad._id %>" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg rounded-4">
                                        <form action="/admin/advertisements/<%= ad._id %>/edit" method="POST" enctype="multipart/form-data">
                                            <div class="modal-header border-bottom-0 pb-0">
                                                <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Advertisement</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4">
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Title *</label>
                                                    <input type="text" name="title" class="form-control rounded-3" value="<%= ad.title %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Image</label>
                                                    <div class="mb-2 d-flex align-items-center gap-2">
                                                        <img src="<%= ad.imageUrl %>" alt="Current image" class="rounded" style="width: 60px; height: 40px; object-fit: cover;">
                                                        <small class="text-muted">Current image (choose a new file to replace)</small>
                                                    </div>
                                                    <input type="file" name="image" class="form-control rounded-3" accept="image/*">
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label fw-bold">Start Time</label>
                                                        <input type="datetime-local" name="startTime" class="form-control rounded-3" value="<%= ad.startTime ? new Date(new Date(ad.startTime).getTime() - new Date(ad.startTime).getTimezoneOffset() * 60000).toISOString().slice(0, 16) : '' %>">
                                                        <small class="text-muted">Default: Starts immediately</small>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label fw-bold">End Time</label>
                                                        <input type="datetime-local" name="endTime" class="form-control rounded-3" value="<%= ad.endTime ? new Date(new Date(ad.endTime).getTime() - new Date(ad.endTime).getTimezoneOffset() * 60000).toISOString().slice(0, 16) : '' %>">
                                                        <small class="text-muted">Default: Never expires</small>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Link (Optional)</label>
                                                    <input type="url" name="link" class="form-control rounded-3" placeholder="https://..." value="<%= ad.link || '' %>">
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Phone Number (Optional)</label>
                                                    <input type="tel" name="phoneNumber" class="form-control rounded-3" placeholder="9999999999" value="<%= ad.phoneNumber || '' %>">
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top-0 pt-0">
                                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No advertisements found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Ad Modal -->
<div class="modal fade" id="addAdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form action="/admin/advertisements" method="POST" enctype="multipart/form-data">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-plus text-primary me-2"></i>Create New Advertisement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Title *</label>
                        <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Summer Sale" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Image *</label>
                        <input type="file" name="image" class="form-control rounded-3" accept="image/*" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Start Time (Optional)</label>
                            <input type="datetime-local" name="startTime" class="form-control rounded-3">
                            <small class="text-muted">Default: Starts immediately</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">End Time (Optional)</label>
                            <input type="datetime-local" name="endTime" class="form-control rounded-3">
                            <small class="text-muted">Default: Never expires</small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Link (Optional)</label>
                        <input type="url" name="link" class="form-control rounded-3" placeholder="https://...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number (Optional)</label>
                        <input type="tel" name="phoneNumber" class="form-control rounded-3" placeholder="9999999999">
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Advertisement</button>
                </div>
            </form>
        </div>
    </div>
</div>


