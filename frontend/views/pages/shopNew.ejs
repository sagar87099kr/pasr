<% layout('./layoutes/boilerplate.ejs') -%>
    <link rel="stylesheet" href="/css/auth.css">

    <body>
        <div class="auth-container">
            <div class="auth-card seller-card">
                <div class="auth-header">
                    <h1 class="auth-title">List Your Shop</h1>
                    <p class="auth-subtitle">Create your digital storefront on PaSr</p>
                    <div class="badge-info mt-3">
                        <i class="fa-solid fa-circle-info"></i> Fields marked with (*) are mandatory
                    </div>
                    <div class="text-danger small mt-2 notranslate">
                        Please fill details in English / कृपया अंग्रेजी में भरें
                    </div>
                </div>

                <form action="/shops" method="POST" novalidate class="needs-validation notranslate"
                    enctype="multipart/form-data">


                    <!-- Shop Name -->
                    <div class="form-group">
                        <label for="shopName" class="form-label">Shop Name *</label>
                        <input type="text" name="shop[shopName]" id="shopName" class="form-control"
                            placeholder="e.g. Fresh Daily Mart" required>
                        <div class="invalid-feedback">Please provide a shop name.</div>
                    </div>

                    <!-- GST Number -->
                    <div class="form-group">
                        <label for="gstNumber" class="form-label">GST Number (Optional) - <span
                                class="text-success small fw-bold">Get More Priority</span></label>
                        <div class="input-group">
                            <input type="text" name="shop[gstNumber]" id="gstNumber" class="form-control"
                                placeholder="15-digit GSTIN (e.g. 24AEQPV2328Q1ZO)" maxlength="15">
                            <span class="input-group-text d-none" id="gst-loader">
                                <i class="fa-solid fa-spinner fa-spin"></i>
                            </span>
                        </div>
                        <div id="gst-feedback" class="mt-1 small" style="min-height: 1.25rem;"></div>
                    </div>

                    <!-- Category -->
                    <div class="form-group">
                        <label for="category" class="form-label">Category *</label>
                        <select class="form-control form-select" name="shop[category]" id="category" required>
                            <option selected disabled value="">Select Category...</option>
                            <option value="Automobile">🚗 Automobile & Parts</option>
                            <option value="Bakery">🍰 Bakery</option>
                            <option value="Beauty/Cosmetics">💄 Beauty/Cosmetics</option>
                            <option value="Coaching">👨‍🏫 Coaching</option>
                            <option value="Dhaba">🥘 Dhaba</option>
                            <option value="Electronics">🔌 Electronics</option>
                            <option value="Fashion">👕 Fashion</option>
                            <option value="Footwear">👟 Footwear</option>
                            <option value="Furniture">🪑 Furniture</option>
                            <option value="General Store">🏪 General Store</option>
                            <option value="Grocery">🛒 Grocery</option>
                            <option value="Hardware">🛠️ Hardware</option>
                            <option value="Jewelers">💍 Jewelers</option>
                            <option value="Medical">💊 Medical</option>
                            <option value="Mobile Shop">📱 Mobile Shop</option>
                            <option value="Non-Veg">🍖 Non-Veg Shop</option>
                            <option value="Printing & Digital">🖨️ Printing & Digital</option>
                            <option value="Restaurant">🍽️ Restaurant</option>
                            <option value="Salon">💇 Salon</option>
                            <option value="Seeds & Fertilizers">🌱 Seeds & Fertilizers</option>
                            <option value="Sports">🏏 Sports</option>
                            <option value="Stationery">📚 Stationery</option>
                            <option value="Sweet Shop">🍬 Sweet Shop</option>
                            <option value="Vegetables & Fruits">🥕 Vegetables & Fruits</option>
                            <option value="Wholesale">🏪 Wholesale</option>
                            <option value="Others">📦 Others</option>
                        </select>
                        <div class="invalid-feedback">Please select a category.</div>
                    </div>

                    <!-- Location -->
                    <div class="form-group">
                        <label for="location" class="form-label">Location / Address *</label>
                        <input type="text" name="shop[location]" id="location" class="form-control"
                            placeholder="Start typing your address..." required>
                        <div class="invalid-feedback">Please provide a location.</div>
                    </div>

                    <!-- Operating Hours -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label for="openingTime" class="form-label">Opening Time</label>
                                <input type="time" name="shop[openingTime]" id="openingTime" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label for="closingTime" class="form-label">Closing Time</label>
                                <input type="time" name="shop[closingTime]" id="closingTime" class="form-control">
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-group">
                        <label for="shopDescription" class="form-label">Description</label>
                        <textarea name="shop[shopDescription]" id="shopDescription" class="form-control" rows="4"
                            placeholder="Describe what you sell..."></textarea>
                    </div>

                    <!-- UPI ID -->
                    <div class="form-group mt-3">
                        <label for="upiId" class="form-label">UPI ID for Payouts *</label>
                        <input type="text" name="shop[upiId]" id="upiId" class="form-control"
                            placeholder="e.g. 9876543210@paytm" required>
                        <div class="invalid-feedback">Please provide a valid UPI ID for platform payouts.</div>
                        <div class="form-text mt-1"><i class="fa-solid fa-money-bill-transfer text-success"></i> PASR
                            will use this UPI ID to send your earnings.</div>

                        <!-- QR Preview -->
                        <div id="qr-preview-container" class="mt-3 p-3 border rounded bg-white text-center"
                            style="display: none;">
                            <p class="small mb-2 text-muted">Scan to Verify Your UPI ID</p>
                            <div id="qrcode" class="d-inline-block"></div>
                            <div class="mt-2 small font-weight-bold text-primary" id="upi-display-id"></div>
                        </div>
                    </div>

                    <!-- Formal Merchant Agreement & Terms of Service with Scroll Lock -->
                    <div class="form-group mt-4 pt-3 border-top">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="fa-solid fa-file-contract text-primary"></i> 
                                <span>Merchant Terms, Conditions & Subscription Agreement *</span>
                            </label>
                            <span id="scroll-status-badge" class="badge bg-secondary rounded-pill fs-8 fw-semibold px-2 py-1">
                                <i class="fa-solid fa-arrows-up-down me-1"></i> Scroll to review
                            </span>
                        </div>

                        <!-- Agreement Scroll Container -->
                        <div id="termsScrollContainer" class="terms-scroll-box p-3 bg-light rounded-3 border" style="max-height: 280px; overflow-y: auto; font-size: 13px; line-height: 1.6; color: #334155; border: 1.5px solid #cbd5e1; box-shadow: inset 0 2px 4px rgba(0,0,0,0.03);">
                            
                            <!-- Key Highlights Summary Grid -->
                            <div class="mb-3 p-3 bg-white rounded-3 border shadow-sm">
                                <h6 class="fw-bold text-primary mb-2 d-flex align-items-center gap-2 fs-7">
                                    <i class="fa-solid fa-table-columns"></i> Key Policy & Subscription Highlights
                                </h6>
                                <div class="row g-2 text-dark fs-8">
                                    <div class="col-sm-6">
                                        <div class="p-2 bg-light rounded border">
                                            <span class="text-muted d-block fw-bold">Platform Plan & Subscription</span>
                                            <strong class="text-primary">Monthly Storefront Maintenance</strong>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-2 bg-light rounded border">
                                            <span class="text-muted d-block fw-bold">Billing Cycle & Invoicing</span>
                                            <strong>Monthly Recurring / Auto-Deducted</strong>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-2 bg-light rounded border">
                                            <span class="text-muted d-block fw-bold">Payouts & Settlement</span>
                                            <strong>Direct UPI (T+1 / Regular Cycles)</strong>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-2 bg-light rounded border">
                                            <span class="text-muted d-block fw-bold">Order Preparation SLA</span>
                                            <strong>15 – 25 Minutes Maximum</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="legal-text">
                                <h6 class="fw-bold text-dark mb-2">1. PREAMBLE & APPLICABILITY</h6>
                                <p>This Merchant Listing and Service Level Agreement ("Agreement") constitutes a legally binding contract entered into between <strong>PASR Platform (Perfectly Assured Service and Rentals)</strong> and the registered merchant ("Merchant", "Shop Owner", or "You"). By registering your shop storefront on the PASR platform, you unconditionally agree to adhere to all terms, policies, operational guidelines, and legal requirements set forth herein.</p>

                                <h6 class="fw-bold text-dark mt-3 mb-2">2. STOREFRONT SUBSCRIPTION & MONTHLY SERVICE FEES</h6>
                                <p><strong>2.1 Monthly Platform Subscription:</strong> To maintain an active, verified digital storefront, index product inventory, and receive local online customer orders through the PASR ecosystem, the Merchant agrees to pay a monthly recurring platform subscription fee as defined by PASR's commercial rate card.</p>
                                <p><strong>2.2 Billing & Invoicing:</strong> Monthly subscription charges are billed in advance at the start of each monthly billing cycle. Invoices will be generated automatically and made accessible in the Merchant Dashboard. Fees may be paid directly or adjusted against the Merchant's accumulated platform settlement credits.</p>
                                <p><strong>2.3 Grace Period & Status Modification:</strong> A grace period of 5 calendar days is provided for renewal payment. Failure to remit the monthly platform subscription fee after the grace period will result in automated temporary deactivation of the storefront and listing hideout until payment is cleared.</p>

                                <h6 class="fw-bold text-dark mt-3 mb-2">3. PRODUCT LISTING, QUALITY & FAIR PRICING INTEGRITY</h6>
                                <p><strong>3.1 Authenticity & Legality:</strong> The Merchant warrants that all listed goods are 100% genuine, unexpired, legally acquired, and comply with all applicable standards under the Consumer Protection Act, Food Safety and Standards Act (FSSAI), and Legal Metrology (Packaged Commodities) Rules.</p>
                                <p><strong>3.2 Price Transparency:</strong> The selling price listed on PASR shall never exceed the Maximum Retail Price (MRP). Any discounts, offers, or price updates must reflect real-time store pricing.</p>
                                <p><strong>3.3 Prohibited Goods:</strong> Listing of banned substances, counterfeit products, expired consumables, hazardous materials, prescription-only drugs without license, adult content, or any illegal contraband is strictly prohibited and shall result in instant permanent blacklisting and legal referral.</p>

                                <h6 class="fw-bold text-dark mt-3 mb-2">4. ORDER FULFILLMENT, PACKAGING & DELIVERY HANDOVER</h6>
                                <p><strong>4.1 Acceptance & SLA:</strong> Upon receipt of an incoming customer order, the Merchant agrees to acknowledge the order within 5 minutes and prepare/pack items within 15–25 minutes.</p>
                                <p><strong>4.2 Packaging Quality:</strong> All items must be securely packed in hygienic, tamper-evident packaging to prevent spillage, damage, or contamination during transit.</p>
                                <p><strong>4.3 Handover to PASR Delivery Partners:</strong> Goods must be handed over exclusively to verified PASR delivery executives after validating the order ID and delivery verification pin.</p>

                                <h6 class="fw-bold text-dark mt-3 mb-2">5. FINANCIAL RECONCILIATION & UPI SETTLEMENTS</h6>
                                <p><strong>5.1 Payout Account:</strong> Payouts for completed orders will be transferred electronically to the Merchant's verified UPI ID or bank account as registered during onboarding.</p>
                                <p><strong>5.2 Deductions & Reconciliations:</strong> PASR reserves the right to adjust or offset amounts for customer refunds resulting from missing items, spoiled goods, merchant cancellation penalties, or applicable platform service fees.</p>

                                <h6 class="fw-bold text-dark mt-3 mb-2">6. INTELLECTUAL PROPERTY & SHARED CATALOG ASSETS</h6>
                                <p><strong>6.1 Media Rights:</strong> Merchant grants PASR a non-exclusive, royalty-free license to display shop names, brand marks, and uploaded product images across digital marketing channels and web platforms.</p>
                                <p><strong>6.2 Master Catalog Usage:</strong> Merchants may utilize PASR's central barcode and shared image repository solely for cataloging goods on the PASR platform.</p>

                                <h6 class="fw-bold text-dark mt-3 mb-2">7. CODE OF CONDUCT, REVIEWS & ZERO-TOLERANCE POLICY</h6>
                                <p>Merchants must maintain professional courtesy with customers and delivery staff. Any abusive behavior, price gouging, off-platform cash extortion, or fraudulent transactions will lead to immediate account termination.</p>

                                <h6 class="fw-bold text-dark mt-3 mb-2">8. GOVERNING LAW & LEGAL JURISDICTION</h6>
                                <p class="mb-0">This Agreement is governed by the laws of India. Any legal dispute or claim arising hereunder shall be subject to the exclusive jurisdiction of the competent courts in Giridih / Jharkhand, India.</p>
                            </div>
                        </div>

                        <!-- Scroll Progress Bar -->
                        <div class="progress mt-2" style="height: 6px;">
                            <div id="termsProgressBar" class="progress-bar bg-primary" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <!-- Agreement Checkbox (Locked until scrolled to bottom) -->
                        <div class="form-check mt-3 d-flex align-items-start gap-2">
                            <input class="form-check-input mt-1" type="checkbox" id="agreeTermsCheckbox" required disabled>
                            <label class="form-check-label fs-7 text-dark fw-semibold" for="agreeTermsCheckbox" id="agreeTermsLabel" style="cursor: not-allowed; opacity: 0.65;">
                                I have completely scrolled, read, understood, and formally agree to the PASR Merchant Terms of Service, Monthly Platform Subscription Agreement, and Operating Guidelines.
                            </label>
                        </div>
                        <div class="invalid-feedback d-block" id="terms-validation-msg" style="display: none !important;">
                            Please scroll to the bottom of the terms and check the box to proceed.
                        </div>
                    </div>

                    <button class="btn-submit mt-3" id="submitShopBtn" disabled style="opacity: 0.6; cursor: not-allowed;">
                        <i class="fa-solid fa-check-circle"></i> List Your Shop
                    </button>
                </form>
            </div>
        </div>

        <script>
            // Terms and Conditions Scroll-to-Accept Logic
            document.addEventListener('DOMContentLoaded', () => {
                const termsBox = document.getElementById('termsScrollContainer');
                const progressBar = document.getElementById('termsProgressBar');
                const badge = document.getElementById('scroll-status-badge');
                const checkbox = document.getElementById('agreeTermsCheckbox');
                const label = document.getElementById('agreeTermsLabel');
                const submitBtn = document.getElementById('submitShopBtn');

                let hasScrolledToBottom = false;

                termsBox.addEventListener('scroll', () => {
                    const scrollTop = termsBox.scrollTop;
                    const scrollHeight = termsBox.scrollHeight - termsBox.clientHeight;
                    const progress = scrollHeight > 0 ? Math.min(100, Math.round((scrollTop / scrollHeight) * 100)) : 100;

                    progressBar.style.width = progress + '%';

                    if (progress >= 95 && !hasScrolledToBottom) {
                        hasScrolledToBottom = true;
                        progressBar.classList.remove('bg-primary');
                        progressBar.classList.add('bg-success');
                        
                        badge.className = 'badge bg-success rounded-pill fs-8 fw-semibold px-2 py-1';
                        badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Agreement Reviewed';

                        checkbox.disabled = false;
                        label.style.cursor = 'pointer';
                        label.style.opacity = '1';
                    }
                });

                checkbox.addEventListener('change', () => {
                    if (checkbox.checked) {
                        submitBtn.disabled = false;
                        submitBtn.style.opacity = '1';
                        submitBtn.style.cursor = 'pointer';
                    } else {
                        submitBtn.disabled = true;
                        submitBtn.style.opacity = '0.6';
                        submitBtn.style.cursor = 'not-allowed';
                    }
                });
            });
        </script>

        <script>
            function initAutocomplete() {
                const input = document.getElementById("location");
                const options = {
                    fields: ["formatted_address", "geometry", "name"],
                    strictBounds: false,
                };

                const autocomplete = new google.maps.places.Autocomplete(input, options);

                autocomplete.addListener("place_changed", () => {
                    const place = autocomplete.getPlace();
                    if (!place.geometry || !place.geometry.location) {
                        return;
                    }
                    // The input value is already updated by the autocomplete widget
                });
            }

            // UPI QR Preview Logic
            document.addEventListener('DOMContentLoaded', () => {
                const upiInput = document.getElementById('upiId');
                const qrContainer = document.getElementById('qr-preview-container');
                const qrDiv = document.getElementById('qrcode');
                const upiDisplay = document.getElementById('upi-display-id');
                let qrcode = null;

                upiInput.addEventListener('input', (e) => {
                    const val = e.target.value.trim();
                    if (val && val.includes('@')) {
                        qrContainer.style.display = 'block';
                        upiDisplay.innerText = val;

                        // Standard UPI Payment String
                        const upiString = `upi://pay?pa=${val}&pn=Shop%20Owner&cu=INR`;

                        if (!qrcode) {
                            qrcode = new QRCode(qrDiv, {
                                text: upiString,
                                width: 128,
                                height: 128,
                                colorDark: "#000000",
                                colorLight: "#ffffff",
                                correctLevel: QRCode.CorrectLevel.H
                            });
                        } else {
                            qrcode.clear();
                            qrcode.makeCode(upiString);
                        }
                    } else {
                        qrContainer.style.display = 'none';
                    }
                });
            });

            // GST Verification Logic
            document.addEventListener('DOMContentLoaded', () => {
                const gstInput = document.getElementById('gstNumber');
                const feedback = document.getElementById('gst-feedback');
                const loader = document.getElementById('gst-loader');
                let debounceTimer;

                const verifyGST = async (val) => {
                    if (val.length < 15) {
                        feedback.innerHTML = '';
                        return;
                    }

                    loader.classList.remove('d-none');
                    feedback.innerHTML = '<span class="text-muted">Verifying GSTIN...</span>';

                    try {
                        const response = await fetch(`/api/v1/gst-lookup?gstin=${val}`);
                        const result = await response.json();

                        if (result.valid) {
                            feedback.innerHTML = `
                                <div class="alert alert-success d-flex align-items-center p-2 mb-0 mt-2" style="border-radius: 12px; border: 1px solid #d1e7dd; background-color: #f8fff9;">
                                    <i class="fa-solid fa-circle-check text-success me-2" style="font-size: 1.1rem;"></i>
                                    <div>
                                        <div class="text-success small fw-bold">GST Received</div>
                                        <div class="text-dark small">We will verify it and notify you.</div>
                                    </div>
                                </div>
                            `;
                        } else {
                            feedback.innerHTML = `<span class="text-danger"><i class="fa-solid fa-circle-xmark"></i> ${result.message}</span>`;
                        }
                    } catch (e) {
                        feedback.innerHTML = '<span class="text-warning">Verification unavailable.</span>';
                    } finally {
                        loader.classList.add('d-none');
                    }
                };

                gstInput.addEventListener('input', (e) => {
                    const val = e.target.value.toUpperCase().trim();
                    gstInput.value = val;

                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => verifyGST(val), 500);
                });
            });
        </script>
        <script
            src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.GOOGLE_MAP_API_KEY %>&libraries=places&callback=initAutocomplete"
            async defer></script>
    </body>