<% layout('./layoutes/boilerplate.ejs') -%>
    <link rel="stylesheet" href="/css/auth.css">

    <style>
        .step-panel { display: none; }
        .step-panel.active { display: block; }

        .step-indicator {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            margin-bottom: 24px;
        }
        .step-dot {
            width: 32px; height: 32px;
            border-radius: 50%;
            background: #e5e7eb;
            color: #9ca3af;
            font-weight: 700;
            font-size: 14px;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.3s;
        }
        .step-dot.active { background: #1E3A8A; color: #fff; }
        .step-dot.done   { background: #16a34a; color: #fff; }
        .step-line {
            flex: 1; max-width: 48px; height: 2px;
            background: #e5e7eb;
            transition: background 0.3s;
        }
        .step-line.done { background: #16a34a; }

        .otp-input {
            font-size: 28px !important;
            font-weight: 800 !important;
            letter-spacing: 0.25em !important;
            text-align: center !important;
        }

        .info-box {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 10px;
            padding: 12px 16px;
            display: flex; align-items: flex-start; gap: 10px;
            margin-bottom: 20px;
            font-size: 13px;
            color: #1e40af;
        }
        .info-box i { margin-top: 2px; flex-shrink: 0; }

        .success-box {
            text-align: center;
            padding: 12px 0 4px;
        }
        .success-icon {
            width: 72px; height: 72px;
            background: #f0fdf4;
            border: 2px solid #bbf7d0;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px;
            font-size: 32px;
        }

        .resend-row {
            text-align: center;
            margin-top: 12px;
            font-size: 13px;
            color: #6b7280;
        }
        .resend-row button {
            background: none; border: none; padding: 0;
            color: #f97316; font-weight: 700; cursor: pointer;
            font-size: 13px;
        }
        .resend-row button:hover { text-decoration: underline; }
        .resend-row button:disabled { color: #9ca3af; cursor: not-allowed; text-decoration: none; }

        .timer-txt { color: #ef4444; font-weight: 700; }

        .password-toggle-wrap { position: relative; }
        .password-toggle-wrap input { padding-right: 44px; }
        .password-toggle-wrap .toggle-eye {
            position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
            cursor: pointer; color: #9ca3af; font-size: 16px;
        }
    </style>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Reset Password</h1>
                <p class="auth-subtitle" id="stepSubtitle">Enter your registered WhatsApp number</p>
            </div>

            <!-- Step Indicator -->
            <div class="step-indicator">
                <div class="step-dot active" id="dot1">1</div>
                <div class="step-line" id="line1"></div>
                <div class="step-dot" id="dot2">2</div>
                <div class="step-line" id="line2"></div>
                <div class="step-dot" id="dot3">3</div>
            </div>

            <!-- Error / Success Banner -->
            <div id="alertBanner" style="display:none; margin-bottom:16px; padding:12px 14px; border-radius:10px; font-size:13px; font-weight:600;"></div>

            <!-- ── Step 1: Enter Phone ─────────────────────────────────── -->
            <div class="step-panel active" id="step1">
                <div class="info-box">
                    <i class="fa-brands fa-whatsapp" style="color:#25D366; font-size:16px;"></i>
                    <span>We'll send a 6-digit OTP to your WhatsApp number. Make sure it's active.</span>
                </div>
                <div class="form-group" style="margin-bottom: 24px;">
                    <label class="form-label">WhatsApp Number *</label>
                    <div style="position:relative;">
                        <span style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#9ca3af;">📱</span>
                        <input type="number" class="form-control" id="phoneInput"
                            placeholder="e.g. 9876543210" style="padding-left:44px;"
                            maxlength="10">
                    </div>
                </div>
                <button class="btn-submit" id="sendOtpBtn" onclick="sendOtp()">
                    <i class="fa-brands fa-whatsapp"></i> Send OTP via WhatsApp
                </button>
                <p style="text-align:center; margin-top:20px; font-size:14px; color:#6b7280;">
                    Remembered your password?
                    <a href="/alreadyLogin" style="color:#1E3A8A; font-weight:700; text-decoration:none;">Log In</a>
                </p>
            </div>

            <!-- ── Step 2: Enter OTP ──────────────────────────────────── -->
            <div class="step-panel" id="step2">
                <div class="success-box">
                    <div class="success-icon">
                        <i class="fa-brands fa-whatsapp" style="color:#25D366;"></i>
                    </div>
                    <p style="font-size:15px; font-weight:700; color:#0f172a; margin-bottom:6px;">Check your WhatsApp!</p>
                    <p style="font-size:13px; color:#6b7280; margin-bottom:24px;">
                        We sent a 6-digit OTP to <strong id="displayPhone"></strong>
                    </p>
                </div>
                <div class="form-group" style="margin-bottom:16px;">
                    <label class="form-label">Enter OTP</label>
                    <input type="text" class="form-control otp-input" id="otpInput"
                        maxlength="6" placeholder="— — — — — —" autocomplete="one-time-code"
                        oninput="this.value=this.value.replace(/\D/g,'').slice(0,6)">
                    <p style="text-align:center; font-size:12px; color:#9ca3af; margin-top:8px;">
                        OTP valid for <span class="timer-txt" id="countdown">10:00</span>
                    </p>
                </div>
                <button class="btn-submit" onclick="verifyOtp()">
                    Continue →
                </button>
                <div class="resend-row">
                    Didn't receive it?
                    <button id="resendBtn" onclick="resendOtp()" disabled>Resend OTP (<span id="resendTimer">30</span>s)</button>
                </div>
            </div>

            <!-- ── Step 3: Set New Password ───────────────────────────── -->
            <div class="step-panel" id="step3">
                <div class="form-group" style="margin-bottom:16px;">
                    <label class="form-label">New Password *</label>
                    <div class="password-toggle-wrap">
                        <input type="password" class="form-control" id="newPassInput" placeholder="Min 4 characters">
                        <i class="fa-regular fa-eye toggle-eye" onclick="togglePass('newPassInput', this)"></i>
                    </div>
                </div>
                <div class="form-group" style="margin-bottom:28px;">
                    <label class="form-label">Confirm Password *</label>
                    <div class="password-toggle-wrap">
                        <input type="password" class="form-control" id="confPassInput" placeholder="Repeat your password">
                        <i class="fa-regular fa-eye toggle-eye" onclick="togglePass('confPassInput', this)"></i>
                    </div>
                </div>
                <button class="btn-submit" onclick="resetPassword()">
                    <i class="fa-solid fa-lock-open"></i> Reset Password
                </button>
            </div>
        </div>
    </div>

    <script>
        let currentPhone = '';
        let currentOtp = '';
        let countdownInterval = null;
        let resendInterval = null;

        // ── Helpers ──────────────────────────────────────────────────────────
        function showAlert(msg, isError = true) {
            const el = document.getElementById('alertBanner');
            el.textContent = msg;
            el.style.display = 'block';
            if (isError) {
                el.style.background = '#fef2f2';
                el.style.color = '#dc2626';
                el.style.border = '1px solid #fecaca';
            } else {
                el.style.background = '#f0fdf4';
                el.style.color = '#16a34a';
                el.style.border = '1px solid #bbf7d0';
            }
        }
        function hideAlert() { document.getElementById('alertBanner').style.display = 'none'; }

        function goToStep(n) {
            document.querySelectorAll('.step-panel').forEach(p => p.classList.remove('active'));
            document.getElementById('step' + n).classList.add('active');
            hideAlert();

            const subtitles = ['', 'Enter your registered WhatsApp number', 'Enter the OTP sent to your WhatsApp', 'Choose a strong new password'];
            document.getElementById('stepSubtitle').textContent = subtitles[n];

            // Update dots
            for (let i = 1; i <= 3; i++) {
                const dot = document.getElementById('dot' + i);
                dot.classList.remove('active', 'done');
                if (i < n) dot.classList.add('done');
                else if (i === n) dot.classList.add('active');
            }
            for (let i = 1; i <= 2; i++) {
                const line = document.getElementById('line' + i);
                line.classList.toggle('done', i < n);
            }
        }

        function setLoading(btnId, loading) {
            const btn = document.getElementById(btnId);
            if (!btn) return;
            btn.disabled = loading;
            btn.style.opacity = loading ? '0.7' : '1';
        }

        function togglePass(id, icon) {
            const input = document.getElementById(id);
            const isPass = input.type === 'password';
            input.type = isPass ? 'text' : 'password';
            icon.classList.toggle('fa-eye', !isPass);
            icon.classList.toggle('fa-eye-slash', isPass);
        }

        // ── OTP Countdown ─────────────────────────────────────────────────────
        function startCountdown() {
            let secs = 10 * 60;
            const el = document.getElementById('countdown');
            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                secs--;
                if (secs <= 0) { clearInterval(countdownInterval); el.textContent = 'Expired'; return; }
                const m = Math.floor(secs / 60).toString().padStart(2, '0');
                const s = (secs % 60).toString().padStart(2, '0');
                el.textContent = `${m}:${s}`;
            }, 1000);
        }

        function startResendTimer() {
            let secs = 30;
            const btn = document.getElementById('resendBtn');
            const timerEl = document.getElementById('resendTimer');
            btn.disabled = true;
            clearInterval(resendInterval);
            resendInterval = setInterval(() => {
                secs--;
                timerEl.textContent = secs;
                if (secs <= 0) {
                    clearInterval(resendInterval);
                    btn.textContent = 'Resend OTP';
                    btn.disabled = false;
                    btn.onclick = resendOtp;
                }
            }, 1000);
        }

        // ── Step 1: Send OTP ─────────────────────────────────────────────────
        async function sendOtp() {
            const phone = document.getElementById('phoneInput').value.trim();
            if (phone.length !== 10 || !/^\d+$/.test(phone)) {
                showAlert('Please enter a valid 10-digit WhatsApp number.');
                return;
            }
            setLoading('sendOtpBtn', true);
            hideAlert();
            try {
                const res = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: phone })
                });
                const data = await res.json();
                if (data.success) {
                    currentPhone = phone;
                    document.getElementById('displayPhone').textContent = '+91 ' + phone;
                    goToStep(2);
                    startCountdown();
                    startResendTimer();
                } else {
                    showAlert(data.message || 'Failed to send OTP. Please try again.');
                }
            } catch (e) {
                showAlert('Network error. Please check your connection.');
            }
            setLoading('sendOtpBtn', false);
        }

        async function resendOtp() {
            await sendOtp();
        }

        // ── Step 2: Verify OTP ───────────────────────────────────────────────
        function verifyOtp() {
            const otp = document.getElementById('otpInput').value.trim();
            if (otp.length !== 6) {
                showAlert('Please enter the 6-digit OTP.');
                return;
            }
            currentOtp = otp;
            goToStep(3);
        }

        // ── Step 3: Reset Password ────────────────────────────────────────────
        async function resetPassword() {
            const newPass = document.getElementById('newPassInput').value;
            const confPass = document.getElementById('confPassInput').value;

            if (newPass.length < 4) { showAlert('Password must be at least 4 characters.'); return; }
            if (newPass !== confPass) { showAlert('Passwords do not match.'); return; }

            hideAlert();
            try {
                const res = await fetch('/api/auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: currentPhone, otp: currentOtp, newPassword: newPass })
                });
                const data = await res.json();
                if (data.success) {
                    showAlert('Password reset successfully! Redirecting to login…', false);
                    setTimeout(() => { window.location.href = '/alreadyLogin'; }, 2000);
                } else {
                    showAlert(data.message || 'Reset failed. Please try again.');
                    // If OTP related error, go back to OTP step
                    if (data.message && (data.message.includes('OTP') || data.message.includes('session'))) {
                        setTimeout(() => goToStep(2), 1500);
                    }
                }
            } catch (e) {
                showAlert('Network error. Please check your connection.');
            }
        }

        // Trigger sendOtp on Enter key in phone field
        document.getElementById('phoneInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') sendOtp();
        });
    </script>