<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments</title>
    <link rel="icon" href="/images/icon.jpeg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
    <style>
        body {
            background-color: #fff;
            padding: 10px;
            font-family: inherit;
        }

        .comments-section {
            margin-top: 5px;
        }

        .comment {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .comment-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #555;
            font-size: 0.9rem;
            flex-shrink: 0;
        }

        .comment-content {
            background: #f8f9fa;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 0.95rem;
        }

        .comment-author {
            font-weight: 600;
            margin-bottom: 4px;
            color: #333;
            display: flex;
            align-items: baseline;
        }

        .reply-btn {
            background: none;
            border: none;
            color: #0d6efd;
            font-size: 0.85rem;
            padding: 0;
            margin-top: 6px;
            font-weight: 500;
        }

        .reply-btn:hover {
            text-decoration: underline;
        }

        .replies {
            margin-top: 15px;
            border-left: 2px solid #dee2e6;
            padding-left: 15px;
        }
    </style>
</head>

<body>
    <div class="comments-section">
        <h5 class="mb-3">Comments (<%= comments.length + comments.reduce((acc, c)=> acc + (c.replies ? c.replies.length
                : 0), 0) %>)</h5>

        <!-- Comment Form -->
        <% if(currUser) { %>
            <form action="/kisan-sabha/<%= post._id %>/comment" method="POST">

                <div class="d-flex gap-2">
                    <div class="comment-avatar" style="width:38px; height:38px;">
                        <%= currUser.name ? currUser.name.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div class="flex-grow-1">
                        <input type="text" name="text" class="form-control rounded-pill"
                            placeholder="Write a comment..." required maxlength="300">
                    </div>
                    <button type="submit" class="btn btn-primary rounded-circle"
                        style="width:38px; height:38px; padding:0;">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </form>
            <% } else { %>
                <div class="alert alert-secondary py-2" style="font-size: 0.9rem;">
                    Please <a href="/login" target="_parent">login</a> to leave a comment.
                </div>
                <% } %>

                    <!-- Comment List -->
                    <% if(comments.length===0) { %>
                        <p class="text-muted text-center my-4" style="font-size: 0.95rem;">No comments yet. Be the first
                            to start the discussion!</p>
                        <% } %>

                            <% comments.forEach(c=> { %>
                                <div class="comment">
                                    <div class="comment-avatar">
                                        <%= c.author.name ? c.author.name.charAt(0).toUpperCase() : 'K' %>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="comment-content">
                                            <div class="d-flex justify-content-between">
                                                <span class="comment-author">
                                                    <%= c.author.name || c.author.username %>
                                                        <small class="text-muted fw-normal ms-2">
                                                            <%= new Date(c.createdAt).toLocaleDateString() %>
                                                        </small>
                                                </span>
                                                <% if(currUser && currUser._id.toString()===c.author._id.toString()) {
                                                    %>
                                                    <form
                                                        action="/kisan-sabha/<%= post._id %>/comment/<%= c._id %>?_method=DELETE"
                                                        method="POST" onsubmit="return confirm('Delete comment?');">

                                                        <button class="btn btn-sm text-danger p-0 border-0"><i
                                                                class="fa-solid fa-trash"></i></button>
                                                    </form>
                                                    <% } %>
                                            </div>
                                            <div style="word-break: break-word;">
                                                <%= c.text %>
                                            </div>

                                            <% if(currUser) { %>
                                                <button class="reply-btn"
                                                    onclick="document.getElementById('replyForm<%= c._id %>').style.display='block'">Reply</button>
                                                <% } %>
                                        </div>

                                        <!-- Reply Form -->
                                        <% if(currUser) { %>
                                            <form action="/kisan-sabha/<%= post._id %>/comments/<%= c._id %>/reply"
                                                method="POST" id="replyForm<%= c._id %>" class="mt-2"
                                                style="display:none;">

                                                <div class="input-group input-group-sm">
                                                    <input type="text" name="text"
                                                        class="form-control rounded-start-pill"
                                                        placeholder="Write a reply..." required maxlength="300">
                                                    <button class="btn btn-outline-primary rounded-end-pill"
                                                        type="submit">Reply</button>
                                                    <button class="btn btn-sm btn-link text-muted text-decoration-none"
                                                        type="button"
                                                        onclick="document.getElementById('replyForm<%= c._id %>').style.display='none'">Cancel</button>
                                                </div>
                                            </form>
                                            <% } %>

                                                <!-- Nested Replies -->
                                                <% if(c.replies && c.replies.length> 0) { %>
                                                    <div class="replies">
                                                        <% c.replies.forEach(r=> { %>
                                                            <div class="comment mb-2">
                                                                <div class="comment-avatar"
                                                                    style="width:30px; height:30px; font-size:0.8rem;">
                                                                    <%= r.author.name ?
                                                                        r.author.name.charAt(0).toUpperCase() : 'K' %>
                                                                </div>
                                                                <div class="flex-grow-1">
                                                                    <div class="comment-content py-1 px-2">
                                                                        <div class="d-flex justify-content-between">
                                                                            <span class="comment-author"
                                                                                style="font-size:0.85rem;">
                                                                                <%= r.author.name || r.author.username
                                                                                    %>
                                                                                    <small class="text-muted ms-2">
                                                                                        <%= new
                                                                                            Date(r.createdAt).toLocaleDateString()
                                                                                            %>
                                                                                    </small>
                                                                            </span>
                                                                            <% if(currUser &&
                                                                                currUser._id.toString()===r.author._id.toString())
                                                                                { %>
                                                                                <form
                                                                                    action="/kisan-sabha/comments/<%= r._id %>?_method=DELETE"
                                                                                    method="POST" class="d-inline"
                                                                                    onsubmit="return confirm('Delete reply?');">
                                                                                    value="<%= csrfToken %>">

                                                                                        <button
                                                                                            class="btn btn-sm text-danger p-0 border-0"><i
                                                                                                class="fa-solid fa-trash"></i></button>
                                                                                </form>
                                                                                <% } %>
                                                                        </div>
                                                                        <div
                                                                            style="font-size:0.9rem; word-break: break-word;">
                                                                            <%= r.text %>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
                                    </div>
                                </div>
                                <% }) %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Send the latest comment count to the parent viewport so it can update its UI dynamically
        window.parent.postMessage({
            type: 'COMMENT_COUNT_UPDATE',
            postId: '<%= post._id %>',
            count: parseInt('<%= post.commentCount %>', 10)
        }, '*');
    </script>
</body>

</html>