<% layout('./layoutes/boilerplate.ejs') -%>
  <link rel="stylesheet" href="/css/auth.css">

  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Login to your PaSr account</p>
      </div>

      <form action="/alreadyLogin" method="POST" novalidate class="needs-validation">

        <div class="form-group">
          <label for="exampleInputEmail1" class="form-label">Mobile Number *</label>
          <input type="number" class="form-control" id="exampleInputEmail1" required="true" name="username"
            placeholder="e.g. 9876543210">
          <div class="invalid-feedback">Please provide your mobile number.</div>
        </div>

        <div class="form-group" style="margin-bottom: 32px;">
          <label for="exampleInputPassword1" class="form-label">Password *</label>
          <input type="password" class="form-control" id="exampleInputPassword1" required="true" name="password"
            placeholder="Enter your password">
          <div class="invalid-feedback">Please provide your password.</div>
        </div>

        <div style="text-align:right; margin-bottom: 8px; margin-top: -8px;">
          <a href="/forgot-password"
            style="color:#f97316; font-weight:700; font-size:13px; text-decoration:none;">
            Forgot Password?
          </a>
        </div>

        <button class="btn-submit" type="submit">Log In</button>

        <!-- Create New Account Section -->
        <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid #e2e8f0; text-align: center;">
          <p style="color: #64748b; font-size: 14px; margin-bottom: 12px; font-weight: 500;">
            Don't have an account?
          </p>
          <a href="/customer/signup" 
             style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 13px; background: #FFF7ED; color: #EA580C; border: 1.5px solid #FDBA74; border-radius: 14px; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.2s ease;"
             onmouseover="this.style.background='#FFEDD5'; this.style.borderColor='#FB923C';"
             onmouseout="this.style.background='#FFF7ED'; this.style.borderColor='#FDBA74';">
            <i class="fa-solid fa-user-plus"></i> Create New Account
          </a>
        </div>

      </form>
    </div>
  </div>