<% layout('layoutes/boilerplate') -%>

    <style>
        .request-container {
            padding: 20px 0;
            max-width: 600px;
            margin: 0 auto;
        }

        .request-card {
            background: #fff;
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid #eef2f6;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-shared {
            background: #eff6ff;
            color: #3b82f6;
        }

        .status-packed {
            background: #ecfdf5;
            color: #10b981;
        }

        .item-row {
            display: flex;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .item-row:last-child {
            border-bottom: none;
        }

        .item-check {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            border: 2px solid #cbd5e1;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            flex-shrink: 0;
        }

        .item-check.checked {
            background: #10b981;
            border-color: #10b981;
            color: #fff;
        }

        .item-details {
            flex: 1;
        }

        .item-name {
            font-weight: 700;
            color: #1e293b;
        }

        .item-meta {
            font-size: 13px;
            color: #64748b;
        }

        .pack-btn {
            background: #6366f1;
            color: #fff;
            border: none;
            padding: 14px;
            border-radius: 14px;
            font-weight: 800;
            width: 100%;
            margin-top: 24px;
            transition: all 0.2s;
        }

        .pack-btn:hover {
            background: #4f46e5;
            transform: translateY(-2px);
        }

        .pack-btn:disabled {
            background: #94a3b8;
            transform: none;
        }
    </style>

    <div class="request-container">
        <div class="request-card">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="h4 fw-800 mb-1">Order Request</h1>
                    <p class="text-muted small mb-0">ID: <%= order.orderId.slice(-8).toUpperCase() %>
                    </p>
                </div>
                <span class="status-badge status-<%= order.orderStatus.toLowerCase().replace('_', '-') %>">
                    <%= order.orderStatus.replace('_', ' ' ) %>
                </span>
            </div>

            <div class="p-3 bg-light rounded-4 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white p-2 rounded-3 text-primary">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div>
                        <div class="fw-700">
                            <%= customer ? customer.name : 'Customer' %>
                        </div>
                        <div class="text-muted small">+91 <%= customer ? customer.username : '' %>
                        </div>
                    </div>
                </div>
            </div>

            <h2 class="h6 fw-800 mb-3 text-uppercase letter-spacing-1">Checklist</h2>
            <div class="items-list">
                <% order.items.forEach((item, index)=> { %>
                    <div class="item-row" onclick="toggleCheck(this)">
                        <div class="item-check">
                            <i class="fa-solid fa-check d-none"></i>
                        </div>
                        <div class="item-details">
                            <div class="item-name">
                                <%= item.name %>
                            </div>
                            <div class="item-meta">Quantity: <%= item.quantity %> | Price: ₹<%= item.price %>
                            </div>
                        </div>
                        <div class="fw-800 text-dark">₹<%= item.price * item.quantity %>
                        </div>
                    </div>
                    <% }) %>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">Order Handling Fee</span>
                    <span class="text-muted">₹5</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-700 text-muted">Total Amount</span>
                    <span class="h4 fw-800 text-success mb-0">₹<%= order.totalAmount %></span>
                </div>
            </div>

            <% if (currUser && String(currUser._id)===String(shop.sellerId) && order.orderStatus==='ORDER_SHARED' ) { %>
                <button class="pack-btn" id="markPackedBtn" onclick="markAsPacked('<%= order._id %>')">
                    <i class="fa-solid fa-box-open me-2"></i> Mark as Packed
                </button>
                <% } else if (order.orderStatus==='ORDER_SHARED' ) { %>
                    <div class="alert alert-info mt-4 small border-0 py-2 rounded-3">
                        <i class="fa-solid fa-info-circle me-1"></i> Login as shopkeeper to notify customer when packed.
                    </div>
                    <% } %>
        </div>
    </div>

    <script>
        function toggleCheck(row) {
            const check = row.querySelector('.item-check');
            const icon = check.querySelector('i');
            check.classList.toggle('checked');
            icon.classList.toggle('d-none');
        }

        async function markAsPacked(orderId) {
            const btn = document.getElementById('markPackedBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Updating...';
            btn.disabled = true;

            try {
                const res = await fetch(`/api/orders/${orderId}/pack`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (res.ok) {
                    window.location.reload();
                } else {
                    const data = await res.json();
                    alert(data.message || 'Failed to update order.');
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (e) {
                alert('Error connecting to server.');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>