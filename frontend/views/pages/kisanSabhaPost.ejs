<% layout('./layoutes/boilerplate.ejs') -%>
    <style>
        .detail-container {
            max-width: 500px;
            margin: 30px auto;
            background: #fff;
            padding: 0;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .post-media-grid {
            display: grid;
            gap: 10px;
            margin-top: 20px;
        }

        .post-media-grid img,
        .post-media-grid video {
            width: 100% !important;
            max-width: 100%;
            height: auto !important;
            max-height: 600px;
            object-fit: contain !important;
            background: #000;
            border-radius: 8px;
            display: block;
        }

        .action-bar {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: space-between;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #f0f0f0;
        }

        .action-btn {
            background: none;
            border: none;
            color: #555;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: color 0.2s;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .action-btn:hover {
            color: #0d6efd;
        }

        .comments-section {
            margin-top: 40px;
        }

        .comment {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .comment-avatar {
            width: 40px;
            height: 40px;
            background: #e0e0e0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .comment-content {
            background: #f8f9fa;
            padding: 12px 15px;
            border-radius: 12px;
            flex-grow: 1;
        }

        .comment-author {
            font-weight: 600;
            margin-bottom: 5px;
            display: block;
        }

        .reply-btn {
            font-size: 0.85rem;
            color: #666;
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            margin-top: 5px;
        }

        .reply-btn:hover {
            color: #0d6efd;
            text-decoration: underline;
        }

        .replies {
            margin-left: 55px;
            margin-top: 15px;
            border-left: 2px solid #e9ecef;
            padding-left: 15px;
        }

        .video-wrapper {
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .play-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 3rem;
            color: rgba(255, 255, 255, 0.85);
            pointer-events: none;
            text-shadow: 0px 0px 10px rgba(0, 0, 0, 0.5);
            transition: opacity 0.2s ease;
        }
    </style>

    <div class="container pb-5">
        <div class="detail-container">
            <div class="px-3 pt-3 pb-2 d-flex align-items-center">
                <div class="author-avatar d-flex justify-content-center align-items-center me-2"
                    style="width:40px; height:40px; font-size:1.1rem; border-radius: 50%;">
                    <%= post.author.name ? post.author.name.charAt(0).toUpperCase() : 'K' %>
                </div>
                <div>
                    <span class="fw-bold fs-5 d-block" style="line-height: 1;">
                        <%= post.author.name || post.author.username %>
                    </span>
                </div>

                <div class="ms-auto d-flex gap-2">
                    <% if(currUser && currUser._id.toString()===post.author._id.toString()) { %>
                        <form action="/kisan-sabha/<%= post._id %>?_method=DELETE" method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this post?');">

                            <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i> Delete
                                Post</button>
                        </form>
                        <% } %>
                            <% if(currUser && currUser._id.toString() !==post.author._id.toString()) { %>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal"
                                    data-bs-target="#reportModal">
                                    <i class="fa-solid fa-flag"></i> Report
                                </button>
                                <% } %>
                </div>
            </div>

            <!-- Media -->
            <% if(post.media && post.media.length> 0) { %>
                <div class="post-media-grid mt-2">
                    <% post.media.forEach(m=> { %>
                        <% if(m.type==='video' ) { %>
                            <div class="video-wrapper">
                                <video src="<%= m.url %>" playsinline style="cursor: pointer;"
                                    onclick="this.paused ? this.play() : this.pause();"
                                    onplay="this.nextElementSibling.style.opacity = '0'"
                                    onpause="this.nextElementSibling.style.opacity = '1'"></video>
                                <i class="fa-solid fa-circle-play play-overlay"></i>
                            </div>
                            <% } else { %>
                                <img src="<%= m.url %>" alt="Post Request Media">
                                <% } %>
                                    <% }) %>
                </div>
                <% } %>

                    <!-- Date Bottom Right -->
                    <div class="text-end px-3 pt-2">
                        <span style="font-size: 0.85rem; color: #888;">
                            <%= new Date(post.createdAt).toLocaleDateString() %>
                        </span>
                    </div>

                    <!-- Content Below Media -->
                    <div class="px-3 pb-3 pt-1">
                        <p style="font-size: 1.1rem; line-height: 1.6; white-space: pre-wrap; margin-bottom: 0;">
                            <%= post.description %>
                        </p>
                    </div>

                    <!-- Actions -->
                    <div class="action-bar">
                        <% if(currUser) { %>
                            <button class="action-btn" id="likeBtn" data-id="<%= post._id %>">
                                <i class="<%= liked ? 'fa-solid' : 'fa-regular' %> fa-thumbs-up"
                                    style="color: <%= liked ? '#0d6efd' : '#555' %>"></i>
                                <span id="likeCount">
                                    <%= post.likeCount %>
                                </span> Likes
                            </button>
                            <button class="action-btn" onclick="openCommentsModal('<%= post._id %>')">
                                <i class="fa-regular fa-comment"></i>
                                <span id="comment-count-<%= post._id %>">
                                    <%= post.commentCount %>
                                </span> Comments
                            </button>
                            <% } else { %>
                                <button class="action-btn" onclick="window.location.href='/alreadyLogin'">
                                    <i class="<%= liked ? 'fa-solid' : 'fa-regular' %> fa-thumbs-up"
                                        style="color: <%= liked ? '#0d6efd' : '#555' %>"></i>
                                    <span id="likeCount">
                                        <%= post.likeCount %>
                                    </span> Likes
                                </button>
                                <button class="action-btn" onclick="window.location.href='/alreadyLogin'">
                                    <i class="fa-regular fa-comment"></i>
                                    <span id="comment-count-<%= post._id %>">
                                        <%= post.commentCount %>
                                    </span> Comments
                                </button>
                                <% } %>

                                    <button class="action-btn ms-auto" onclick="sharePost()">
                                        <i class="fa-solid fa-share-nodes"></i> Share
                                    </button>
                    </div>


        </div>
    </div>

    <!-- Comments Modal (Iframe) -->
    <div class="modal fade" id="commentsModal" tabindex="-1" aria-labelledby="commentsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg modal-fullscreen-sm-down">
            <div class="modal-content" style="height: 85vh;">
                <div class="modal-header">
                    <h5 class="modal-title" id="commentsModalLabel"><i class="fa-regular fa-comments me-2"></i>Comments
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0" style="overflow: hidden;">
                    <iframe id="commentsIframe" src="" style="width: 100%; height: 100%; border: none;"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Modal -->
    <div class="modal fade" id="reportModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/kisan-sabha/<%= post._id %>/report" method="POST">

                    <div class="modal-header">
                        <h5 class="modal-title">Report Post</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Reason</label>
                            <select name="reason" class="form-select" required>
                                <option value="spam">Spam or Misleading</option>
                                <option value="misinformation">Fake News / Misinformation</option>
                                <option value="inappropriate">Inappropriate Content</option>
                                <option value="hate_speech">Hate Speech</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Additional Details (Optional)</label>
                            <textarea name="details" class="form-control" rows="3" maxlength="300"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Submit Report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function openCommentsModal(postId) {
            const iframe = document.getElementById('commentsIframe');
            iframe.src = '/kisan-sabha/' + postId + '/comments-ui';
            const commentsModal = new bootstrap.Modal(document.getElementById('commentsModal'));
            commentsModal.show();
        }

        // Clear iframe on close to reset layout
        document.getElementById('commentsModal').addEventListener('hidden.bs.modal', function () {
            document.getElementById('commentsIframe').src = '';
        });

        // Listen for comment count updates from the iframe
        window.addEventListener('message', function (event) {
            if (event.data && event.data.type === 'COMMENT_COUNT_UPDATE') {
                const countSpan = document.getElementById('comment-count-' + event.data.postId);
                if (countSpan) {
                    countSpan.innerText = event.data.count;
                }
            }
        });

        // AJAX Like
        document.getElementById('likeBtn').addEventListener('click', async function () {
            const id = this.getAttribute('data-id');
            const icon = this.querySelector('i');
            const countSpan = document.getElementById('likeCount');

            try {
                const res = await fetch(`/kisan-sabha/${id}/like`, {
                    method: 'POST',
                    headers: {
                    }
                });

                const data = await res.json();

                if (data.success) {
                    countSpan.innerText = data.likeCount;
                    if (data.liked) {
                        icon.classList.remove('fa-regular');
                        icon.classList.add('fa-solid');
                        icon.style.color = '#0d6efd';
                    } else {
                        icon.classList.remove('fa-solid');
                        icon.classList.add('fa-regular');
                        icon.style.color = '#555';
                    }
                } else {
                    if (res.status === 401) {
                        if (typeof window.showLoginModal === 'function') {
                            window.showLoginModal();
                        } else {
                            window.location.href = '/login';
                        }
                        return;
                    }
                }
            } catch (e) {
                console.error(e);
            }
        });

        // Share API + DB tracking
        async function sharePost() {
            try {
                // ping DB to increment share count
                fetch("/kisan-sabha/<%= post._id %>/share", {
                    method: "POST",
                    headers: {
                    }
                });


                // native share sheet
                if (navigator.share) {
                    await navigator.share({
                        title: 'Kisan Sabha Post',
                        text: 'Check out this update from the field on Kisan Sabha!',
                        url: window.location.href
                    });
                } else {
                    navigator.clipboard.writeText(window.location.href);
                    alert("Link copied to clipboard!");
                }
            } catch (e) {
                console.error("Error sharing:", e);
            }
        }
    </script>