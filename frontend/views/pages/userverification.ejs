<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Verification</title>
  <link rel="icon" href="/images/icon.jpeg">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
</head>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    display: block;
    margin: 0;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    background: #f6f7fb;
    padding: 24px;
  }

  .profile-card {
    width: 100%;
    height: auto;
    max-width: 520px;
    background: #fff;
    border: 1px solid #e9e9ef;
    border-radius: 16px;
    padding: 18px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .06);
  }

  .card-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .name {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    margin: 0;
    line-height: 1.2;
    word-break: break-word;
  }

  .sub {
    font-size: 13px;
    color: #6b7280;
    margin: 0;
  }

  .badge {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid;
    user-select: none;
    white-space: nowrap;
  }

  .badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  /* Verified states */
  .badge.true {
    color: #065f46;
    background: #ecfdf5;
    border-color: #a7f3d0;
  }

  .badge.verified .dot {
    background: #10b981;
  }

  .badge.false {
    color: #991b1b;
    background: #fef2f2;
    border-color: #fecaca;
  }

  .badge.not-verified .dot {
    background: #ef4444;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .row {
    display: flex;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid #eeeef6;
    border-radius: 12px;
    background: #fbfbff;
  }

  .label {
    width: 120px;
    flex: 0 0 120px;
    font-size: 12px;
    color: #6b7280;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
  }

  .value {
    font-size: 14px;
    color: #111827;
    font-weight: 600;
    word-break: break-word;
    min-width: 0;
  }

  @media (max-width: 420px) {
    .row {
      flex-direction: column;
    }

    .label {
      width: auto;
      flex: 0 0 auto;
    }
  }

  .badge-button {
    color: #065f46;
    background: #ecfdf5;
    border-color: #a7f3d0;
  }
</style>

<body>
  <div class="main-container" style="max-width: 1200px; margin: 0 auto;">

      <!-- SEARCH BAR -->
      <div style="margin: 20px 0; display: flex; justify-content: center;">
        <form action="/customer/verify" method="GET" style="display: flex; gap: 10px; width: 100%; max-width: 500px;">
          <input type="text" name="search" class="form-control" placeholder="Search by name or mobile..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
          <button type="submit" class="btn btn-primary">Search</button>
          <% if(typeof searchQuery !== 'undefined' && searchQuery) { %>
            <a href="/customer/verify" class="btn btn-outline-secondary">Clear</a>
          <% } %>
        </form>
      </div>

      <!-- SECTION 1: PENDING VERIFICATION -->
      <div style="text-align: center; margin: 30px 0 20px;">
          <h2 style="color: #991b1b; margin-bottom: 5px;">Pending Verification (<%= typeof pendingCount !== 'undefined' ? pendingCount : unverified.length %>)</h2>
          <p style="color: #666; font-size: 14px; margin: 0;">Total Customers: <%= typeof totalCustomers !== 'undefined' ? totalCustomers : 'N/A' %> (Showing 20 most recent)</p>
      </div>

      <div class="card-grid"
        style="display: flex; flex-direction: row-reverse; flex-wrap: wrap; gap: 24px; justify-content: center;">

        <% if(unverified.length===0) { %>
          <p style="text-align: center; width: 100%; color: #666;">No pending verifications.</p>
          <% } %>

            <% for (customer of unverified){%>
              <section class="profile-card">
                <div class="card-top">
                  <div class="title">
                    <p class="name">
                      <%=customer.name%>
                    </p>
                    <p class="sub">Customer / Provider Profile</p>
                  </div>

                  <span class="badge <%=customer.verified%>">
                    <span class="dot"></span>
                    verification: <%=customer.verified%> by <%=customer.verifedBy%>
                  </span>
                  <% if(customer.isPrepaidOnly) { %>
                    <span class="badge false" style="margin-left: 8px;">Prepaid Only</span>
                  <% } %>
                </div>

                <div class="details">
                  <div class="row">
                    <div class="label">Number</div>
                    <div class="value">
                      <%=customer.username%>
                    </div>
                  </div>

                  <div class="row">
                    <div class="label">Address</div>
                    <div class="value">
                      <%=customer.address%>
                    </div>
                  </div>

                  <div class="row">
                    <div class="label">Pincode</div>
                    <div class="value">
                      <%=customer.pincode%> Joined at:<%=customer.createdAt%>
                    </div>
                  </div>
                </div>
                <div class="action" style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <button class="badge false" style="margin-top: 2px;"
                    onclick="openAdminDeleteConfirm('<%=customer._id%>')">Delete customer</button>
                  <button class="badge <%= customer.isPrepaidOnly ? 'true' : 'false' %>" style="margin-top: 2px;"
                    onclick="togglePrepaid('<%=customer._id%>', this)"><%= customer.isPrepaidOnly ? 'Unmark Prepaid' : 'Mark Prepaid Only' %></button>
                </div>
              </section>
              <%}%>
      </div>

      <!-- SECTION 2: VERIFIED -->
      <h2
        style="margin: 50px 0 20px; color: #065f46; text-align: center; border-top: 1px solid #eee; padding-top: 20px;">
        Verified Customers (<%= typeof verifiedCount !== 'undefined' ? verifiedCount : verified.length %>)</h2>

      <div class="card-grid"
        style="display: flex; flex-direction: row-reverse; flex-wrap: wrap; gap: 24px; justify-content: center;">
        <% for (customer of verified){%>
          <section class="profile-card" style="opacity: 0.9;">
            <div class="card-top">
              <div class="title">
                <p class="name">
                  <%=customer.name%>
                </p>
                <p class="sub">Customer / Provider Profile</p>
              </div>

              <span class="badge <%=customer.verified%>">
                <span class="dot"></span>
                verification: <%=customer.verified%> by <%=customer.verifedBy%>
              </span>
              <% if(customer.isPrepaidOnly) { %>
                <span class="badge false" style="margin-left: 8px;">Prepaid Only</span>
              <% } %>
            </div>

            <div class="details">
              <div class="row">
                <div class="label">Number</div>
                <div class="value">
                  <%=customer.username%>
                </div>
              </div>

              <div class="row">
                <div class="label">Address</div>
                <div class="value">
                  <%=customer.address%>
                </div>
              </div>

              <div class="row">
                <div class="label">Pincode</div>
                <div class="value">
                  <%=customer.pincode%> Joined at:<%=customer.createdAt%>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="action" style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button class="badge <%= customer.isPrepaidOnly ? 'true' : 'false' %>" style="margin-top: 2px;"
                onclick="togglePrepaid('<%=customer._id%>', this)"><%= customer.isPrepaidOnly ? 'Unmark Prepaid' : 'Mark Prepaid Only' %></button>
            </div>
          </section>
          <%}%>
      </div>

  </div>
  <!-- Admin Customer Delete Modal -->
  <div id="adminDeleteModal"
    style="display:none; position:fixed; z-index:9999; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:16px; padding:30px; width:90%; max-width:400px; text-align:center;">
      <div
        style="width:60px; height:60px; background:#fee2e2; color:#ef4444; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; font-size:24px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          <line x1="10" y1="11" x2="10" y2="17"></line>
          <line x1="14" y1="11" x2="14" y2="17"></line>
        </svg>
      </div>
      <h3 style="margin:0 0 8px 0; font-size:20px; font-weight:700; color:#1f2937;">Delete Customer?</h3>
      <p style="margin:0 0 24px 0; font-size:15px; color:#6b7280; line-height:1.5;">
        Are you sure you want to delete this customer? This will remove their profile and data.
      </p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
        <button onclick="closeAdminDeleteModal()"
          style="padding:10px; border:1px solid #e5e7eb; background:#fff; border-radius:8px; font-weight:600; cursor:pointer;">
          Cancel
        </button>
        <form id="adminDeleteForm" method="POST" style="margin:0;">

          <button
            style="width:100%; padding:10px; background:#ef4444; color:#fff; border:none; border-radius:8px; font-weight:600; cursor:pointer;">
            Delete
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    async function togglePrepaid(customerId, btnElement) {
      if (!confirm("Are you sure you want to toggle 'Prepaid Only' for this customer?")) return;
      try {
        const response = await fetch(`/customer/toggle-prepaid/${customerId}`, { method: 'POST' });
        const data = await response.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert("Error: " + data.message);
        }
      } catch (err) {
        console.error(err);
        alert("Failed to toggle status.");
      }
    }

    function openAdminDeleteConfirm(customerId) {
      const modal = document.getElementById('adminDeleteModal');
      const form = document.getElementById('adminDeleteForm');
      form.action = `/customer/${customerId}/verifyfail?_method=DELETE`;
      modal.style.display = "flex";
    }

    function closeAdminDeleteModal() {
      const modal = document.getElementById('adminDeleteModal');
      modal.style.display = "none";
    }

    window.onclick = function (event) {
      const modal = document.getElementById('adminDeleteModal');
      if (event.target == modal) {
        modal.style.display = "none";
      }
    }
  </script>
  <script src="/js/script.js"></script>
</body>