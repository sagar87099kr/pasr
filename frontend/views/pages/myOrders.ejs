<% layout('./layoutes/boilerplate.ejs') -%>
    <style>
        .cart-container {
            padding: 20px 0;
            background: transparent;
            min-height: 80vh;
        }

        .cart-header {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 24px;
            color: #1e293b;
        }

        .shop-section {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .shop-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f1f5f9;
        }

        .shop-title {
            font-size: 20px;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cart-item {
            display: flex;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .cart-item img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 12px;
            margin-right: 15px;
            flex-shrink: 0;
            border: 1px solid #f1f5f9;
        }

        .cart-item-details {
            flex: 1;
            min-width: 0;
        }

        .cart-item-title {
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cart-item-price {
            font-size: 16px;
            font-weight: 800;
            color: #10b981;
        }

        .cart-item-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .shop-summary-card {
            background: #f8fafc;
            border-radius: 16px;
            padding: 20px;
            margin-top: 20px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 15px;
            color: #475569;
        }

        .summary-total {
            font-size: 18px;
            font-weight: 800;
            border-top: 1px dashed #cbd5e1;
            padding-top: 12px;
            color: #0f172a;
        }

        @media (max-width: 576px) {
            .cart-item {
                flex-wrap: wrap;
            }

            .cart-item-actions {
                width: 100%;
                justify-content: space-between;
                margin-top: 10px;
                padding-left: 95px;
            }
        }
    </style>

    <div class="cart-container" style="max-width: 900px; margin: 0 auto; display: block;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="cart-header m-0">My Orders</h1>
        </div>

        <% if (orders && orders.length> 0) { %>
            <% orders.forEach(order=> { %>
                <div class="shop-section">
                    <div class="shop-header">
                        <div class="shop-title">
                            <i class="fa-solid fa-box text-primary"></i>
                            <% if(order.resolvedSeller) { %>
                                <%= order.resolvedSeller.name %>
                                    <% } else { %>
                                        Market Item
                                        <% } %>
                        </div>
                        <span class="text-muted" style="font-size: 0.85rem;">
                            <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric' , month: 'short'
                                , year: 'numeric' }) %>
                        </span>
                    </div>

                    <div class="items-list">
                        <% order.items.forEach(item=> { %>
                            <div class="cart-item">
                                <!-- Default placeholder since order.items in some routes might not populate imageUrl completely uniformly as cart -->
                                <img src="<%= item.imageUrl || item.image || '/images/placeholder.jpg' %>"
                                    alt="<%= item.name %>">
                                <div class="cart-item-details">
                                    <div class="cart-item-title">
                                        <%= item.name %> &times; <%= item.quantity %>
                                    </div>
                                    <div class="cart-item-price">₹<%= item.price * item.quantity %>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>

                    <div class="shop-summary-card mt-3">
                        <div class="summary-row">
                            <span>Status</span>
                            <span>
                                <% let statusColor='bg-secondary' ; if (order.orderStatus==='CREATED' )
                                    statusColor='bg-info text-dark' ; else if (order.orderStatus==='ACCEPTED' )
                                    statusColor='bg-primary' ; else if (order.orderStatus==='READY_FOR_DELIVERY' )
                                    statusColor='bg-warning text-dark' ; else if (order.orderStatus==='ASSIGNED' )
                                    statusColor='bg-info' ; else if (order.orderStatus==='OUT_FOR_DELIVERY' )
                                    statusColor='bg-primary' ; else if (order.orderStatus==='COMPLETED' )
                                    statusColor='bg-success' ; else if (order.orderStatus==='CANCELLED' )
                                    statusColor='bg-danger' ; %>
                                    <span class="badge <%= statusColor %> px-2 py-1">
                                        <%= order.orderStatus.replace(/_/g, ' ' ) %>
                                    </span>
                            </span>
                        </div>
                        <div class="summary-row">
                            <span>Delivery Target</span>
                            <span>
                                <% if (order.deliveryType==='SELF_PICKUP' ) { %>
                                    <span class="badge bg-secondary">🏪 Self Pickup</span>
                                    <% } else { %>
                                        <span class="badge bg-info text-dark">🚚 Home Delivery</span>
                                        <% } %>
                            </span>
                        </div>
                        <div class="summary-row">
                            <span>Delivery Charge</span>
                            <span>
                                <% if (order.firstOrderDiscount> 0) { %>
                                    <span style="text-decoration:line-through; color:#94a3b8;">₹<%=
                                            order.firstOrderDiscount %></span>
                                    <span class="text-success fw-bold ms-1">FREE 🎉</span>
                                    <% } else { %>
                                        ₹<%= order.deliveryCharge %>
                                            <% } %>
                            </span>
                        </div>
                        <div class="summary-row">
                            <span>Payment</span>
                            <span
                                class="badge <%= order.paymentStatus === 'COLLECTED' || order.paymentStatus === 'VERIFIED' ? 'bg-success' : 'bg-warning text-dark' %>">
                                <%= order.paymentType %> (<%= order.paymentStatus %>)
                            </span>
                        </div>

                        <% if(order.orderStatus !=='COMPLETED' && order.orderStatus !=='CANCELLED' && order.deliveryOTP)
                            { %>
                            <div class="summary-row mt-3 border rounded px-3 py-2 bg-white align-items-center">
                                <span class="text-muted fw-bold" style="font-size: 0.85rem;">Delivery OTP</span>
                                <span class="fw-bold text-dark fs-5 tracking-widest">
                                    <%= order.deliveryOTP %>
                                </span>
                            </div>
                            <% } %>

                            <% if (order.orderStatus === 'OUT_FOR_DELIVERY' && order.deliveryPartnerId) { %>
                            <div class="mt-3 border rounded px-3 py-2 bg-light d-flex align-items-center gap-3">
                                <img src="<%= order.deliveryPartnerId.profilePhoto || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(order.deliveryPartnerId.fullName) + '&background=random' %>" alt="Partner" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 1px solid #ccc;">
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark mb-0 lh-1"><%= order.deliveryPartnerId.fullName %></div>
                                    <small class="text-muted" style="font-size: 0.75rem;">Delivery Partner</small>
                                </div>
                                <a href="tel:<%= order.deliveryPartnerId.phoneNumber %>" class="btn btn-sm btn-success rounded-circle" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;" aria-label="Call Partner">
                                    <i class="fa-solid fa-phone"></i>
                                </a>
                            </div>
                            <% } %>


                                <% if (order.coinDiscount && order.coinDiscount > 0) { %>
                                <div class="summary-row">
                                    <span>Coin Discount</span>
                                    <span class="text-success fw-bold">-₹<%= order.coinDiscount %></span>
                                </div>
                                <% } %>
                                <div class="summary-row summary-total">
                                    <span>Order Total</span>
                                    <span style="color:#138808">₹<%= order.totalAmount %></span>
                                </div>

                                <!-- Customer Actions -->
                                <% if(currUser && order.customerId.toString() === currUser._id.toString() && !['PACKED', 'READY_FOR_DELIVERY', 'ASSIGNED', 'OUT_FOR_DELIVERY', 'COMPLETED', 'CANCELLED'].includes(order.orderStatus)) { %>
                                    <div class="d-grid gap-2 mt-4 pt-3 border-top">
                                        <button class="btn btn-sm btn-outline-danger w-100 fw-bold" onclick="cancelOrder('<%= order._id %>')">
                                            <i class="fa-solid fa-xmark"></i> Cancel Order
                                        </button>
                                    </div>
                                <% } %>

                                <!-- Shop Owner Actions -->
                                <% if(currUser && order.resolvedSeller &&
                                    order.resolvedSeller.sellerId.toString()===currUser._id.toString()) { %>
                                    <div class="d-grid gap-2 mt-4 pt-3 border-top">
                                        <% if (order.paymentType==='PREPAID' && order.paymentStatus==='PENDING' ) { %>
                                            <button class="btn btn-sm btn-success w-100"
                                                onclick="verifyOrderPayment('<%= order._id %>')">
                                                <i class="fa-solid fa-check-circle"></i> Confirm Payment
                                            </button>
                                            <% } else if (order.orderStatus==='CREATED' && order.paymentType==='COD' ) {
                                                %>
                                                <button class="btn btn-sm btn-primary w-100"
                                                    onclick="acceptCodOrder('<%= order._id %>')">
                                                    <i class="fa-solid fa-thumbs-up"></i> Accept COD Order
                                                </button>
                                                <% } %>

                                                    <% if (['ACCEPTED', 'READY_FOR_DELIVERY'
                                                        ].includes(order.orderStatus)) { %>
                                                        <button class="btn btn-sm btn-info w-100 text-white"
                                                            onclick="requestDelivery('<%= order._id %>')">
                                                            <i class="fa-solid fa-motorcycle"></i> Request Delivery
                                                        </button>
                                                        <% } %>
                                    </div>
                                    <% } %>
                    </div>
                </div>
                <% }) %>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="fa-solid fa-box-open mb-3" style="font-size: 60px; color: #d1d5db;"></i>
                            <h3 style="color: #6b7280;">No Orders Yet</h3>
                            <p class="text-muted">Looks like you haven't placed any orders.</p>
                            <a href="/shops" class="btn btn-primary mt-3">Start Shopping</a>
                        </div>
                        <% } %>
    </div>

    <!-- Shop Owner Action Scripts -->
    <script>
        async function verifyOrderPayment(orderId) {
            if (!confirm("Have you verified that the UPI payment was received in your bank account?")) return;
            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
                const res = await fetch(`/api/orders/${orderId}/verify-payment`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (res.ok) {
                    alert("Payment Verified! Order accepted and ready for delivery.");
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to verify payment");
                }
            } catch (e) {
                alert("Error: " + e.message);
            }
        }

        async function acceptCodOrder(orderId) {
            if (!confirm("Accept this Cash on Delivery order?")) return;
            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
                const res = await fetch(`/api/orders/${orderId}/accept`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (res.ok) {
                    alert("Order accepted!");
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to accept order");
                }
            } catch (e) {
                alert("Error: " + e.message);
            }
        }

        async function requestDelivery(orderId) {
            if (!confirm("Request a delivery partner for this order?")) return;
            try {
                const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
                const res = await fetch(`/api/orders/${orderId}/request-delivery`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (res.ok) {
                    alert("Delivery requested successfully!");
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to request delivery");
                }
            } catch (e) {
                alert("Error: " + e.message);
            }
        }

        async function cancelOrder(orderId) {
            if (!confirm("Are you sure you want to cancel this order? If prepaid, a refund will be initiated automatically.")) return;
            try {
                const res = await fetch(`/api/orders/${orderId}/cancel`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to cancel order");
                }
            } catch (e) {
                alert("Error: " + e.message);
            }
        }

        // --- Live Order Tracking Polling ---
        let initialStatusHash = '';
        <% 
            const activeStatuses = orders.filter(o => o.orderStatus !== 'COMPLETED' && o.orderStatus !== 'CANCELLED')
                                       .map(o => o._id + ':' + o.orderStatus)
                                       .join('|');
        %>
        initialStatusHash = '<%= activeStatuses %>';

        async function pollOrderStatuses() {
            if (!initialStatusHash) return; // No active orders to track
            try {
                const res = await fetch('/api/orders/api/my-active-status');
                if (res.ok) {
                    const data = await res.json();
                    if (data.success && data.activeOrders) {
                        const newHash = data.activeOrders.map(o => o._id + ':' + o.orderStatus).join('|');
                        if (newHash !== initialStatusHash) {
                            // Status changed in the background! Reload seamlessly.
                            window.location.reload();
                        }
                    }
                }
            } catch (e) {
                console.error("Tracking polling error:", e);
            }
        }
        
        // Ping every 15 seconds to check for live delivery/shop updates
        setInterval(pollOrderStatuses, 15000); 
    </script>