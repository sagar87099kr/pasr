<% layout('layoutes/boilerplate') -%>

    <style>
        .cart-container {
            padding: 20px 0;
            min-height: 80vh;
        }

        .cart-header {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 24px;
            color: #1e293b;
        }

        .shop-section {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .shop-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f1f5f9;
        }

        .shop-title {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cart-item {
            display: flex;
            align-items: center;
            padding: 16px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .cart-item img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 12px;
            margin-right: 15px;
            border: 1px solid #f1f5f9;
        }

        .cart-item-details {
            flex: 1;
        }

        .cart-item-title {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .cart-item-price {
            font-size: 15px;
            font-weight: 800;
            color: #10b981;
        }

        .cart-qty-controls {
            display: flex;
            align-items: center;
            background: #f8fafc;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }

        .cart-qty-btn {
            background: transparent;
            border: none;
            color: #475569;
            padding: 4px 10px;
            cursor: pointer;
        }

        .cart-qty-value {
            font-weight: 700;
            color: #475569;
            min-width: 20px;
            text-align: center;
        }

        .shop-summary-card {
            background: #f8fafc;
            border-radius: 16px;
            padding: 20px;
            margin-top: 20px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 15px;
            color: #475569;
        }

        .summary-total {
            font-size: 18px;
            font-weight: 800;
            border-top: 1px dashed #cbd5e1;
            padding-top: 12px;
            color: #0f172a;
            margin-top: 10px;
        }

        .whatsapp-btn {
            background: #25D366;
            color: #fff;
            border: none;
            padding: 14px;
            border-radius: 14px;
            font-weight: 800;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: transform 0.2s;
        }

        .whatsapp-btn:active {
            transform: scale(0.98);
        }
    </style>

    <div class="container" style="max-width: 800px;">
        <div class="cart-container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="cart-header m-0">My Cart</h1>
                <% if (cart && cart.items.length> 0) { %>
                    <button onclick="clearCart()" class="btn btn-sm btn-outline-danger" style="border-radius: 50px;">
                        <i class="fa-solid fa-trash-can"></i> Clear
                    </button>
                    <% } %>
            </div>

            <% if (!cart || cart.items.length===0) { %>
                <div class="text-center py-5 bg-white rounded-4 border">
                    <i class="fa-solid fa-cart-shopping mb-3" style="font-size: 60px; color: #d1d5db;"></i>
                    <h3 style="color: #6b7280;">Your cart is empty</h3>
                    <a href="/home" class="btn btn-primary mt-3">Start Shopping</a>
                </div>
                <% } else { %>
                    <% const groupedItems={}; cart.items.forEach(item=> {
                        if (!groupedItems[item.shopId]) {
                        groupedItems[item.shopId] = { name: item.shopName, items: [], subtotal: 0 };
                        }
                        groupedItems[item.shopId].items.push(item);
                        groupedItems[item.shopId].subtotal += (item.price * item.quantity);
                        });
                        %>

                        <% Object.keys(groupedItems).forEach(shopId=> {
                            const group = groupedItems[shopId];
                            %>
                            <div class="shop-section" id="shop-<%= shopId %>">
                                <div class="shop-header">
                                    <div class="shop-title"><i class="fa-solid fa-store text-primary"></i>
                                        <%= group.name %>
                                    </div>
                                    <span class="badge bg-light text-dark border">
                                        <%= group.items.length %> items
                                    </span>
                                </div>

                                <div class="items-list">
                                    <% group.items.forEach(item=> { %>
                                        <div class="cart-item">
                                            <img src="<%= item.image || '/images/placeholder.jpg' %>"
                                                alt="<%= item.name %>">
                                            <div class="cart-item-details">
                                                <div class="cart-item-title">
                                                    <%= item.name %>
                                                </div>
                                                <div class="cart-item-price">₹<%= item.price %>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="cart-qty-controls">
                                                    <button class="cart-qty-btn"
                                                        onclick="updateQty('<%= item.itemId %>', 'decrease')">-</button>
                                                    <span class="cart-qty-value">
                                                        <%= item.quantity %>
                                                    </span>
                                                    <button class="cart-qty-btn"
                                                        onclick="updateQty('<%= item.itemId %>', 'increase')">+</button>
                                                </div>
                                                <button class="btn text-danger p-0"
                                                    onclick="removeItem('<%= item.itemId %>')">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>

                                <div class="shop-summary-card">
                                    <div class="summary-row">
                                        <span>Subtotal</span>
                                        <span>₹<%= group.subtotal %></span>
                                    </div>
                                    <div class="summary-row">
                                        <span>Delivery</span>
                                        <span class="text-success fw-bold">Pay at Shop</span>
                                    </div>
                                    <div class="summary-row summary-total">
                                        <span>Total Amount</span>
                                        <span style="color:#138808">₹<%= group.subtotal %></span>
                                    </div>

                                    <div class="mt-4">
                                        <div class="alert alert-info py-2 px-3 border-0 small mb-3"
                                            style="background: #eef2ff; color: #4338ca; border-radius: 12px;">
                                            <i class="fa-solid fa-info-circle me-1"></i> Pay directly to the shopkeeper
                                            when you pick up your items.
                                        </div>
                                        <button class="whatsapp-btn" onclick="sendToWhatsapp('<%= shopId %>')">
                                            <i class="fa-brands fa-whatsapp"></i> Send Order to WhatsApp
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>
        </div>
    </div>

    <script>
        async function updateQty(itemId, action) {
            const res = await fetch(`/api/cart/update/${itemId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action })
            });
            if (res.ok) window.location.reload();
        }

        async function removeItem(itemId) {
            const res = await fetch(`/api/cart/remove/${itemId}`, {
                method: 'DELETE'
            });
            if (res.ok) window.location.reload();
        }

        async function clearCart() {
            if (!confirm('Clear your entire cart?')) return;
            const res = await fetch('/api/cart/clear', { method: 'POST' });
            if (res.ok) window.location.reload();
        }

        async function sendToWhatsapp(shopId) {
            const btn = event.currentTarget;
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/orders/checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ shopId })
                });

                const data = await res.json();
                if (res.ok && data.waUrl) {
                    // Open WhatsApp and then reload/redirect
                    window.open(data.waUrl, '_blank');
                    setTimeout(() => {
                        window.location.href = '/api/orders/my-orders';
                    }, 1000);
                } else {
                    alert(data.message || 'Error processing order.');
                }
            } catch (e) {
                alert('Error connecting to server.');
            } finally {
                btn.innerHTML = originalContent;
                btn.disabled = false;
            }
        }
    </script>