<% layout('layoutes/boilerplate') %>

<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px);">
    <div class="card-header bg-transparent border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
        <h3 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-map-location-dot text-primary me-2"></i>Bazaar Management</h3>
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addBazaarModal">
            <i class="fa-solid fa-plus me-2"></i> Add Bazaar
        </button>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="border-0 rounded-start">Name</th>
                        <th class="border-0">Location</th>
                        <th class="border-0">Coordinates</th>
                        <th class="border-0">Status</th>
                        <th class="border-0 rounded-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(bazaars && bazaars.length > 0) { %>
                        <% bazaars.forEach(function(b) { %>
                            <tr>
                                <td class="fw-bold"><%= b.name %></td>
                                <td class="text-muted"><%= b.location %></td>
                                <td><small class="badge bg-secondary"><%= b.geometry.coordinates[1].toFixed(4) %>, <%= b.geometry.coordinates[0].toFixed(4) %></small></td>
                                <td>
                                    <% if(b.isActive) { %>
                                        <span class="badge bg-success rounded-pill">Active</span>
                                    <% } else { %>
                                        <span class="badge bg-danger rounded-pill">Inactive</span>
                                    <% } %>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary rounded-circle"><i class="fa-solid fa-pen"></i></button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No bazaars found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Bazaar Modal -->
<div class="modal fade" id="addBazaarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form action="/admin/bazaars" method="POST">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="fa-solid fa-plus text-primary me-2"></i>Create New Bazaar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Bazaar Name</label>
                        <input type="text" name="name" class="form-control rounded-3" placeholder="e.g. Doranda" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">City/District Location</label>
                        <input type="text" name="location" class="form-control rounded-3" placeholder="e.g. Giridih" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Latitude</label>
                            <input type="number" step="any" name="lat" class="form-control rounded-3" placeholder="24.3211">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Longitude</label>
                            <input type="number" step="any" name="lng" class="form-control rounded-3" placeholder="85.9525">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Bazaar</button>
                </div>
            </form>
        </div>
    </div>
</div>
