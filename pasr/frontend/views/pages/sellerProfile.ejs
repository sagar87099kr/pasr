<% layout('./layoutes/boilerplate.ejs') -%>
    <link rel="stylesheet" href="/css/localMarket.css">
    <style>
        /* Seller Profile Header Styling */
        .seller-profile-header {
            background: linear-gradient(135deg, #138808 0%, #0d6efd 100%);
            border-radius: 12px;
            padding: 30px;
            color: white;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 24px;
            flex-wrap: wrap;
        }

        .seller-avatar-large {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: white;
            color: #138808;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            border: 4px solid rgba(255, 255, 255, 0.3);
            flex-shrink: 0;
        }

        .seller-info h1 {
            margin: 0 0 8px 0;
            font-weight: 700;
            font-size: 28px;
        }

        .seller-meta {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 12px;
            font-size: 15px;
        }

        .seller-meta span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .contact-buttons {
            display: flex;
            gap: 12px;
            margin-top: 10px;
        }

        .contact-buttons .btn {
            border-radius: 50px;
            padding: 8px 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-white {
            background: white;
            color: #138808;
            border: none;
        }

        .btn-white:hover {
            background: #f8f9fa;
            color: #0f6c06;
        }

        .btn-outline-white {
            background: transparent;
            color: white;
            border: 2px solid white;
        }

        .btn-outline-white:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .section-title {
            font-weight: 700;
            margin-bottom: 20px;
            color: #1f2937;
            font-size: 22px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
    </style>

    <div class="container mt-4 mb-5">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/localMarket" style="text-decoration:none; color:#6b7280;">Local
                        Bazzar</a></li>
                <li class="breadcrumb-item active" aria-current="page">Seller Profile</li>
            </ol>
        </nav>

        <!-- Seller Header -->
        <div class="seller-profile-header">
            <div class="seller-avatar-large">
                <i class="fa-solid fa-user-store"></i>
            </div>
            <div class="seller-info flex-grow-1">
                <h1>
                    <%= seller.name %>
                </h1>
                <div class="seller-meta">
                    <span>
                        <i class="fa-solid fa-store" style="opacity: 0.8;"></i>
                        Local Seller
                    </span>
                    <% if(seller.address) { %>
                        <span>
                            <i class="fa-solid fa-location-dot" style="opacity: 0.8;"></i>
                            <%= seller.address %>
                        </span>
                        <% } %>
                            <span style="background: rgba(255,255,255,0.2); padding: 2px 8px; border-radius: 4px;">
                                <i class="fa-solid fa-box" style="opacity: 0.8;"></i>
                                <%= products.length %> Products Listed
                            </span>
                </div>

                <div class="contact-buttons">
                    <a href="/action/call/<%= seller.username %>" class="btn btn-white shadow-sm">
                        <i class="fa-solid fa-phone"></i> Call Seller
                    </a>
                    <a href="https://wa.me/91<%= seller.username %>?text=Hi%20<%= encodeURIComponent(seller.name) %>,%20I%20saw%20your%20profile%20on%20Local%20Bazzar!"
                        target="_blank" class="btn btn-outline-white">
                        <i class="fa-brands fa-whatsapp"></i> Message
                    </a>
                </div>
            </div>
        </div>

        <!-- Products Grid Section -->
        <h3 class="section-title">
            <i class="fa-solid fa-boxes-stacked text-primary"></i>
            Products by <%= seller.name %>
        </h3>

        <% if (products && products.length> 0) { %>
            <div class="market-grid" style="margin-top: 20px;">
                <% for (let product of products) { %>
                    <a href="/products/<%= product._id %>" class="product-card-link">
                        <div
                            class="product-card <%= (currUser && product.owner._id.equals(currUser._id)) ? 'owned-shop-card' : '' %>">
                            <% if (currUser && product.owner._id.equals(currUser._id)) { %>
                                <div class="owned-shop-badge">
                                    <i class="fa-solid fa-user-check"></i> Your Product
                                </div>
                                <% } %>
                                    <div class="product-img-wrap">
                                        <img src="<%= optimizeImage(product.productImage[0].url) %>"
                                            alt="<%= product.productName %>">
                                        <div class="price-tag">
                                            <%= product.price %>
                                        </div>
                                    </div>
                                    <div class="card-body-custom">
                                        <h5 class="prod-title">
                                            <%= product.productName %>
                                        </h5>
                                        <div class="prod-meta mt-2">
                                            <span><i class="fa-solid fa-tag"></i>
                                                <%= product.categories %>
                                            </span>
                                            <span><i class="fa-solid fa-map-pin"></i>
                                                <%= product.location %>
                                            </span>
                                        </div>
                                        <div class="text-muted mt-2 small">
                                            Quantity Available: <strong>
                                                <%= product.quantity %>
                                            </strong>
                                        </div>
                                    </div>
                        </div>
                    </a>
                    <% } %>
            </div>
            <% } else { %>
                <!-- Empty State -->
                <div class="alert alert-light text-center p-5 border" style="border-radius: 12px;">
                    <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
                    <h4 class="text-secondary">No products available</h4>
                    <p class="text-muted mb-0">This seller currently has no active products listed in the Local Bazzar.
                    </p>
                </div>
                <% } %>

    </div>