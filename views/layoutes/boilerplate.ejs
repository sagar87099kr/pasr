<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PaSr</title>

    <!-- Preconnect to external origins to reduce DNS+TCP overhead -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

    <!-- Inline critical CSS: :root vars + navbar shell + language FAB -->
    <style>
        :root {
            --bg: #f6f7fb;
            --surface: #ffffff;
            --text: #0f172a;
            --muted: #64748b;
            --border: rgba(15, 23, 42, 0.10);
            --border2: rgba(15, 23, 42, 0.08);
            --shadow: 0 14px 40px rgba(15, 23, 42, 0.10);
            --shadow2: 0 18px 55px rgba(15, 23, 42, 0.14);
            --radius: 22px;
            --radius2: 18px;
        }

        body {
            margin: 0;
            font-family: 'Outfit', system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        .navbar {
            border-bottom: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.86);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        .contain {
            width: min(1100px, calc(100% - 28px));
            margin: 16px auto 44px;
            display: grid;
            gap: 16px;
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }

        /* ── Language FAB ── */
        #lang-toggle-fab {
            position: fixed;
            bottom: 20px;
            left: 16px;
            z-index: 1030;
            /* Below Bootstrap modal backdrop (1040) so it gets covered correctly */
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(15, 23, 42, 0.12);
            border-radius: 999px;
            box-shadow: 0 6px 24px rgba(15, 23, 42, 0.14);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            cursor: pointer;
            user-select: none;
            transition: box-shadow .18s ease, transform .18s ease;
        }

        #lang-toggle-fab:hover {
            box-shadow: 0 10px 32px rgba(15, 23, 42, 0.18);
            transform: translateY(-2px);
        }

        .lang-label {
            font-size: 12px;
            font-weight: 800;
            color: #94a3b8;
            transition: color .18s ease;
            min-width: 18px;
            text-align: center;
            line-height: 1;
        }

        #lang-toggle-fab:not(.lang-hi) #lang-label-en,
        #lang-toggle-fab.lang-hi #lang-label-hi {
            color: #6366f1;
        }

        /* Custom toggle pill */
        .lang-switch-wrap {
            position: relative;
            display: inline-flex;
            align-items: center;
            width: 38px;
            height: 22px;
            cursor: pointer;
            margin: 0;
            flex-shrink: 0;
        }

        .lang-switch-wrap input {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
        }

        .lang-slider {
            position: absolute;
            inset: 0;
            background: #e2e8f0;
            border-radius: 999px;
            transition: background .18s ease;
        }

        .lang-slider::before {
            content: "";
            position: absolute;
            width: 16px;
            height: 16px;
            left: 3px;
            top: 3px;
            background: #fff;
            border-radius: 50%;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
            transition: transform .2s ease;
        }

        .lang-switch-wrap input:checked~.lang-slider {
            background: #6366f1;
        }

        .lang-switch-wrap input:checked~.lang-slider::before {
            transform: translateX(16px);
        }

        /* Prevent Google Translate bar from ever causing layout shifts or grey blur */
        .goog-te-banner-frame,
        .goog-te-gadget,
        #goog-gt-tt,
        .goog-tooltip {
            display: none !important;
        }

        body {
            top: 0 !important;
        }

        .skiptranslate {
            display: none !important;
        }

        /* ── Signup nudge banner (shared link pages) ── */
        #signup-nudge-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 1035;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            padding: 12px 18px;
            background: linear-gradient(135deg, #1e1b4b, #312e81);
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.18);
            animation: nudge-slide-up 0.4s ease;
        }

        @keyframes nudge-slide-up {
            from {
                transform: translateY(100%);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        #signup-nudge-bar>div {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nudge-btn-primary {
            padding: 7px 16px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            background: #fff;
            color: #312e81 !important;
            text-decoration: none;
        }

        .nudge-btn-secondary {
            padding: 7px 16px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.4);
            cursor: pointer;
        }

        .nudge-close {
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.7);
            font-size: 16px;
            cursor: pointer;
            padding: 4px 6px;
        }
    </style>



    <!-- Google Fonts — non-blocking with font-display=swap for faster text render -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
        as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap">
    </noscript>

    <!-- Bootstrap CSS — non-blocking -->
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" as="style"
        onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    </noscript>

    <!-- All local CSS — non-blocking (critical vars are already inlined above) -->
    <link rel="preload" href="/css/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link rel="stylesheet" href="/css/style.css">
    </noscript>
    <% if (typeof useProfileCss !=='undefined' && useProfileCss) { %>
        <link rel="preload" href="/css/profile.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
        <noscript>
            <link rel="stylesheet" href="/css/profile.css">
        </noscript>
        <% } %>

            <% if (typeof useInsideCateCss !=='undefined' && useInsideCateCss) { %>
                <link rel="preload" href="/css/insidecate.css" as="style"
                    onload="this.onload=null;this.rel='stylesheet'">
                <noscript>
                    <link rel="stylesheet" href="/css/insidecate.css">
                </noscript>
                <% } %>

                    <!-- Font Awesome — non-blocking (icons are not LCP elements) -->
                    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
                        as="style" onload="this.onload=null;this.rel='stylesheet'"
                        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
                        crossorigin="anonymous" referrerpolicy="no-referrer">
                    <noscript>
                        <link rel="stylesheet"
                            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
                            crossorigin="anonymous">
                    </noscript>

                    <link rel="icon" href="/images/icon.jpeg">
                    <link rel="manifest" href="/manifest.json">
                    <meta name="theme-color" content="#6366f1">
                    <meta name="apple-mobile-web-app-capable" content="yes">
                    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

                    <script>
                        if ('serviceWorker' in navigator) {
                            window.addEventListener('load', () => {
                                navigator.serviceWorker.register('/sw.js')
                                    .then(reg => console.log('SW registered!', reg))
                                    .catch(err => console.log('SW failed', err));
                            });
                        }
                    </script>
</head>

<body>

    <!-- Fixed Language Toggle — visible on every page, bottom-left corner -->
    <div id="lang-toggle-fab" title="Switch Language">
        <span class="lang-label" id="lang-label-en">EN</span>
        <label class="lang-switch-wrap">
            <input type="checkbox" id="languageSwitch" role="switch" aria-label="Switch to Hindi">
            <span class="lang-slider"></span>
        </label>
        <span class="lang-label" id="lang-label-hi">हि</span>
    </div>

    <%- include("../includes/navbar.ejs") %>


        <div class="<%= typeof containerClass != 'undefined' ? containerClass : 'contain' %>">
            <%- include("../includes/flash.ejs") %>
                <%- body %>
        </div>
        <%- include("../includes/footer.ejs") %>

            <!-- Bootstrap JS — deferred, loads after paint -->
            <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
                integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
                crossorigin="anonymous" defer></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
                integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
                crossorigin="anonymous" defer></script>

            <!-- Image compressor — only needed on upload forms, deferred -->
            <script type="text/javascript"
                src="https://cdn.jsdelivr.net/npm/browser-image-compression@2.0.2/dist/browser-image-compression.js"
                defer></script>
            <script src="/js/imageCompressor.js" defer></script>
            <script src="/js/script.js" defer></script>
            <script src="/js/pwa-install.js" defer></script>

            <!-- Google Maps — deferred and loaded LAST (only conditionally included) -->
            <% if (typeof useMaps !=='undefined' && useMaps) { %>
                <script
                    src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.GOOGLE_MAP_API_KEY %>&callback=initMap"
                    defer></script>
                <% } %>

                    <!-- Google Translate Widget (Hidden) -->
                    <div id="google_translate_element" style="display:none"></div>

                    <script type="text/javascript">
                        function googleTranslateElementInit() {
                            new google.translate.TranslateElement({
                                pageLanguage: 'en',
                                includedLanguages: 'en,hi',
                                autoDisplay: false
                            }, 'google_translate_element');
                        }

                        // Custom Language Logic
                        document.addEventListener('DOMContentLoaded', function () {
                            const langPref = localStorage.getItem('languagePreference');
                            const languageSwitch = document.getElementById('languageSwitch');
                            const langFab = document.getElementById('lang-toggle-fab');

                            function setFabState(isHindi) {
                                if (langFab) langFab.classList.toggle('lang-hi', isHindi);
                            }

                            if (languageSwitch) {
                                // Set initial state based on preference
                                if (langPref === 'hi') {
                                    languageSwitch.checked = true;
                                    setFabState(true);
                                    triggerHindiTranslation();
                                } else {
                                    languageSwitch.checked = false;
                                    setFabState(false);
                                }

                                // Listen for changes
                                languageSwitch.addEventListener('change', function () {
                                    if (this.checked) {
                                        localStorage.setItem('languagePreference', 'hi');
                                        setFabState(true);
                                        triggerHindiTranslation();
                                    } else {
                                        localStorage.setItem('languagePreference', 'en');
                                        // clear changes by reloading or resetting
                                        window.location.reload();
                                    }
                                });
                            }

                            function triggerHindiTranslation() {
                                // We need to wait for the Google Translate frame to load
                                const checkInterval = setInterval(function () {
                                    const select = document.querySelector('.goog-te-combo');
                                    if (select) {
                                        clearInterval(checkInterval);
                                        select.value = 'hi';
                                        select.dispatchEvent(new Event('change'));
                                    }
                                }, 500);

                                // Styles to hide the top bar if it appears
                                const style = document.createElement('style');
                                style.innerHTML = `
            body { top: 0 !important; } 
            .goog-te-banner-frame { display: none !important; }
          `;
                                document.head.appendChild(style);
                            }
                        });
                    </script>
                    <script type="text/javascript"
                        src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
                        defer></script>
                    <!-- Global Loader -->
                    <style>
                        #global-loader {
                            position: fixed;
                            top: 0;
                            left: 0;
                            width: 100%;
                            height: 100%;
                            background: rgba(255, 255, 255, 0.9);
                            z-index: 9999;
                            display: none;
                            /* Hidden by default */
                            justify-content: center;
                            align-items: center;
                            flex-direction: column;
                            gap: 15px;
                            backdrop-filter: blur(4px);
                        }

                        .loader-spinner {
                            width: 50px;
                            height: 50px;
                            border: 4px solid #e5e7eb;
                            border-top: 4px solid #111827;
                            /* Primary Dark Color */
                            border-radius: 50%;
                            animation: spin 0.8s linear infinite;
                        }

                        @keyframes spin {
                            0% {
                                transform: rotate(0deg);
                            }

                            100% {
                                transform: rotate(360deg);
                            }
                        }

                        .loader-text {
                            font-family: system-ui, -apple-system, sans-serif;
                            font-weight: 600;
                            color: #374151;
                            font-size: 16px;
                            animation: pulse 1.5s infinite ease-in-out;
                        }

                        @keyframes pulse {

                            0%,
                            100% {
                                opacity: 1;
                            }

                            50% {
                                opacity: 0.6;
                            }
                        }
                    </style>

                    <div id="global-loader">
                        <div class="loader-spinner"></div>
                        <div class="loader-text">Storing your data, please wait...</div>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', () => {
                            const loader = document.getElementById('global-loader');

                            // Show loader on valid form submission
                            document.addEventListener('submit', (e) => {
                                const form = e.target;

                                // If the form is invalid, let the browser show validation errors and DO NOT show loader
                                if (!form.checkValidity()) {
                                    return;
                                }

                                // Check if it's a delete form (by action URL containing DELETE or class)
                                const isDelete = form.action.includes('?_method=DELETE') ||
                                    form.classList.contains('delete-form') ||
                                    (form.method && form.method.toUpperCase() === 'DELETE');

                                if (isDelete) {
                                    return; // Don't show loader for delete
                                }

                                // If valid and not delete, show loader
                                loader.style.display = 'flex';
                            });

                            // Hide loader when page restores from back/forward cache
                            window.addEventListener('pageshow', (event) => {
                                if (event.persisted) {
                                    loader.style.display = 'none';
                                }
                            });
                        });
                    </script>

                    <!-- Welcome Signup Modal (For Unauthenticated Users Only — Global) -->
                    <% if (typeof currUser==='undefined' || !currUser) { %>
                        <div class="modal fade" id="welcomeSignupModal" tabindex="-1"
                            aria-labelledby="welcomeSignupModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content shadow-lg border-0" style="border-radius: 1rem;">
                                    <div class="modal-header border-0 pb-0 d-flex justify-content-end">
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-center pt-0 px-4 pb-4">
                                        <div class="mb-3">
                                            <i class="fa-solid fa-hand-sparkles text-warning"
                                                style="font-size: 3rem;"></i>
                                        </div>
                                        <h4 class="fw-bold mb-3" id="welcomeSignupModalLabel">Welcome to PASR.IN! 👋
                                        </h4>
                                        <p class="text-muted mb-4" style="font-size: 0.95rem;">
                                            Join our growing local community! Connect with farmers on <strong>Kisan
                                                Sabha</strong>,
                                            discover fresh neighborhood goods in the <strong>Local Bazaar</strong>, and
                                            book
                                            verified
                                            <strong>Home Services</strong> instantly.
                                        </p>
                                        <div class="d-grid gap-2">
                                            <a href="/customer/signup" class="btn btn-primary fw-bold py-2"
                                                style="border-radius: 50px;">
                                                Join Now — It's Free!
                                            </a>
                                            <a href="/alreadyLogin" class="btn btn-outline-secondary fw-bold py-2 mt-2"
                                                style="border-radius: 50px;">
                                                I already have an account
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Small non-blocking signup nudge banner (shown on non-home pages) -->
                        <div id="signup-nudge-bar" style="display:none;">
                            <span>👋 New here? Join <strong>PASR.IN</strong> — it's free!</span>
                            <div>
                                <a href="/customer/signup" class="nudge-btn-primary">Sign Up</a>
                                <button type="button" class="nudge-btn-secondary" data-bs-toggle="modal"
                                    data-bs-target="#welcomeSignupModal">Login</button>
                                <button type="button" class="nudge-close" id="nudge-close-btn"
                                    aria-label="Close">✕</button>
                            </div>
                        </div>

                        <script>
                            document.addEventListener("DOMContentLoaded", () => {
                                const isHomePage = window.location.pathname === '/home' || window.location.pathname === '/';
                                const alreadySeen = sessionStorage.getItem('welcomeModalShown');

                                if (!alreadySeen) {
                                    if (isHomePage) {
                                        // Full blocking modal — fine on home, user is just browsing
                                        setTimeout(() => {
                                            const el = document.getElementById('welcomeSignupModal');
                                            if (el) {
                                                new bootstrap.Modal(el).show();
                                                sessionStorage.setItem('welcomeModalShown', 'true');
                                            }
                                        }, 2000);
                                    } else {
                                        // Shared link / profile / shop page — show small non-blocking banner
                                        setTimeout(() => {
                                            const bar = document.getElementById('signup-nudge-bar');
                                            if (bar) bar.style.display = 'flex';
                                            sessionStorage.setItem('welcomeModalShown', 'true');
                                        }, 1500);
                                    }
                                }

                                // Close nudge bar
                                const closeBtn = document.getElementById('nudge-close-btn');
                                if (closeBtn) closeBtn.addEventListener('click', () => {
                                    document.getElementById('signup-nudge-bar').style.display = 'none';
                                });
                            });
                        </script>
                        <% } %>
</body>

</html>