    font-weight: 600;
    margin-bottom: 2px;
  }
  .suggestion-item-subtitle {
    font-size: 0.75rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('navbarSearchInput');
    const suggestionsDropdown = document.getElementById('searchSuggestionsDropdown');
    let debounceTimer;

    if (!searchInput || !suggestionsDropdown) return;

    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      
      clearTimeout(debounceTimer);
      
      if (query.length < 2) {
        suggestionsDropdown.style.display = 'none';
        return;
      }
      
      debounceTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search/suggestions?q=${encodeURIComponent(query)}`);
          if (!res.ok) return;
          const data = await res.json();
          renderSuggestions(data);
        } catch (err) {
          console.error('Error fetching search suggestions:', err);
        }
      }, 300);
    });

    // Hide dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !suggestionsDropdown.contains(e.target)) {
        suggestionsDropdown.style.display = 'none';
      }
    });

    function renderSuggestions(data) {
      let html = '';
      
      if (data.items && data.items.length > 0) {
        html += `<div class="suggestion-group-title">Items</div>`;
        data.items.forEach(item => {
          html += `
            <a href="/shops/${item.shop ? item.shop._id : ''}" class="suggestion-item">
              <div class="suggestion-item-title">${item.name || 'Unnamed Item'} <span style="color:#16a34a; font-size:0.8rem">₹${item.price}</span></div>
              <div class="suggestion-item-subtitle"><i class="fa-solid fa-store"></i> ${item.shop ? item.shop.shopName : ''}</div>
            </a>
          `;
        });
      }
      
      if (data.shops && data.shops.length > 0) {
        html += `<div class="suggestion-group-title">Local Shops</div>`;
        data.shops.forEach(shop => {
          html += `
            <a href="/shops/${shop._id}" class="suggestion-item">
              <div class="suggestion-item-title">${shop.shopName}</div>
              <div class="suggestion-item-subtitle"><i class="fa-solid fa-location-dot"></i> ${shop.category} &middot; ${shop.location}</div>
            </a>
          `;
        });
      }

      if (data.products && data.products.length > 0) {
        html += `<div class="suggestion-group-title">Products</div>`;
        data.products.forEach(product => {
          html += `
            <a href="/products/${product._id}" class="suggestion-item">
              <div class="suggestion-item-title">${product.productName} <span style="color:#16a34a; font-size:0.8rem">₹${product.price}</span></div>
              <div class="suggestion-item-subtitle"><i class="fa-solid fa-leaf"></i> ${product.categories} &middot; ${product.location}</div>
            </a>
          `;
        });
      }

      if (data.providers && data.providers.length > 0) {
        html += `<div class="suggestion-group-title">Service Providers</div>`;
        data.providers.forEach(provider => {
          html += `
            <a href="/provider/${provider._id}/profile" class="suggestion-item">
              <div class="suggestion-item-title">${provider.company}</div>
              <div class="suggestion-item-subtitle"><i class="fa-solid fa-briefcase"></i> ${provider.categories} &middot; ${provider.location}</div>
            </a>
          `;
        });
      }

      if (html === '') {
        html = '<div class="suggestion-item"><div class="suggestion-item-subtitle" style="justify-content:center;">No quick results found.<br>Press enter to search all.</div></div>';
      }

      suggestionsDropdown.innerHTML = html;
      suggestionsDropdown.style.display = 'block';
    }
  });
</script>