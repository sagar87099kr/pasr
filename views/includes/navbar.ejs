<% if (typeof currUser !=='undefined' && currUser) { %>
  <script>
    async function fetchNotifications() {
      try {
        const res = await fetch('/api/notifications');
        const data = await res.json();
        if (data.success) {
          renderNotifications(data.notifications);
        }
      } catch (e) {
        console.error('Error fetching notifications:', e);
      }
    }

    function renderNotifications(notifications) {
      const list = document.getElementById('notificationList');
      const badge = document.getElementById('notificationBadge');
      const container = document.getElementById('notificationContainer');
      const headerWrapper = document.getElementById('notificationHeaderWrapper');

      if (!list || !container || !headerWrapper) return;

      if (notifications.length === 0) {
        headerWrapper.style.display = 'none';
        list.innerHTML = '<div class="no-notifications">No notification yet</div>';
        if (badge) badge.style.display = 'none';
        return;
      }

      headerWrapper.style.display = 'block';
      if (badge) badge.style.display = 'block';

      list.innerHTML = notifications.map(n => `
      <a href="${n.type === 'ORDER_RECEIVED' ? '/api/orders/my-shop-orders' : '/api/orders/my-orders'}" class="notification-item ${n.isRead ? '' : 'unread'}" onclick="markAsRead('${n._id}')">
        <span class="notification-title">${n.title}</span>
        <span class="notification-msg">${n.message}</span>
        <span class="notification-time">${new Date(n.createdAt).toLocaleString()}</span>
      </a>
    `).join('');
    }

    async function markAsRead(id) {
      try {
        await fetch(`/api/notifications/mark-read/${id}`, { method: 'POST' });
      } catch (e) {
        console.error('Error marking as read:', e);
      }
    }

    async function markAllNotificationsAsRead(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      try {
        const res = await fetch('/api/notifications/mark-all-read', { method: 'POST' });
        if (res.ok) {
          fetchNotifications();
        }
      } catch (e) {
        console.error('Error marking all as read:', e);
      }
    }

    // Initial fetch
    fetchNotifications();
    // Poll every 30 seconds for faster shopkeeper alerts
    setInterval(fetchNotifications, 30000);
  </script>
  <% } %>

