                                                text-transform: uppercase;
                                                letter-spacing: 0.05em;
                                                color: #6b7280;
                                                margin-bottom: 8px;
                                            }

                                            .size-chips {
                                                display: flex;
                                                flex-wrap: wrap;
                                                gap: 8px;
                                            }

                                            .size-chip input[type="checkbox"] {
                                                display: none;
                                            }

                                            .size-chip label {
                                                display: inline-block;
                                                padding: 6px 13px;
                                                border: 2px solid #d1d5db;
                                                border-radius: 20px;
                                                font-size: 13px;
                                                font-weight: 600;
                                                cursor: pointer;
                                                background: #fff;
                                                color: #374151;
                                                transition: all 0.18s;
                                                user-select: none;
                                            }

                                            .size-chip input[type="checkbox"]:checked+label {
                                                border-color: #138808;
                                                background: #138808;
                                                color: #fff;
                                            }

                                            .size-chip label:hover {
                                                border-color: #138808;
                                                color: #138808;
                                            }
                                        </style>

                                        <!-- Kids Infant (UK 1–9) -->
                                        <div class="size-group" data-size-group="kids-infant">
                                            <div class="size-group-label">👶 Kids – Infant (UK 1–9)</div>
                                            <div class="size-chips">
                                                <% ['1','2','3','4','5','6','7','8','9'].forEach(function(s){ %>
                                                    <span class="size-chip">
                                                        <input type="checkbox" name="item[sizes][]"
                                                            value="Kids-Infant-UK<%= s %>" id="sz_add_ki_<%= s %>">
                                                        <label for="sz_add_ki_<%= s %>">UK <%= s %></label>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                        </div>

                                        <!-- Kids Junior (UK 10–3) -->
                                        <div class="size-group" data-size-group="kids-junior">
