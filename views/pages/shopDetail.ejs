                                                    <span class="size-chip">
                                                        <input type="checkbox" name="item[sizes][]"
                                                            value="Women-UK<%= s %>"
                                                            id="sz_add_w_<%= s.replace('.','_') %>">
                                                        <label for="sz_add_w_<%= s.replace('.','_') %>">UK <%= s %>
                                                        </label>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                        </div>

                                        <!-- Men (UK 5–12) -->
                                        <div class="size-group" data-size-group="men">
                                            <div class="size-group-label">👞 Men (UK 5–12)</div>
                                            <div class="size-chips">
                                                <% ['5','6','7','8','9','10','11','12'].forEach(function(s){ %>
                                                    <span class="size-chip">
                                                        <input type="checkbox" name="item[sizes][]"
                                                            value="Men-UK<%= s %>"
                                                            id="sz_add_m_<%= s.replace('.','_') %>">
                                                        <label for="sz_add_m_<%= s.replace('.','_') %>">UK <%= s %>
                                                        </label>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>

                                        <!-- Dynamic Fashion Sizes (Add Item) -->
