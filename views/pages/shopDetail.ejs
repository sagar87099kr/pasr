                            <label>Quantity</label>
                            <input type="number" id="editItemQuantity" name="item[quantity]" required min="0"
                                placeholder="0"
                                style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:8px;">
                        </div>

                        <!-- 6 & 7. Categories -->
                        <% const scEdit = (shop.category || "").toString().trim().toLowerCase(); %>
                        <% if(scEdit === 'fashion' || scEdit === 'footwear' || scEdit === 'footwears') { %>
                            <div class="field" id="editPrimaryCategoryField">
                                <label>Primary Category</label>
                                <select id="editPrimaryCategorySelect" class="form-control"
                                    style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:8px;">
                                    <option value="" disabled selected>Select Primary Category</option>
                                    <option value="men"><%= (scEdit === 'footwear' || scEdit === 'footwears') ? "Men's Footwear" : "Mens Wear" %></option>
                                    <option value="women"><%= (scEdit === 'footwear' || scEdit === 'footwears') ? "Women's Footwear" : "Womens Wear" %></option>
                                    <option value="kids"><%= (scEdit === 'footwear' || scEdit === 'footwears') ? "Kids' Footwear" : "Kids Wear" %></option>
                                    <option value="none">Others & Accessories</option>
                                </select>
                            </div>

                            <div class="field" id="editItemCategoryField" style="display: none;">
                                <label>Sub Category</label>
                                <select id="editItemCategory" name="item[itemCategory]" class="form-control"
                                    style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:8px;"
                                    required>
                                    <option value="" disabled>Select Sub Category</option>
                                    <% const editCatData = getShopCategoryData(shop.category); %>
                                    <% if(editCatData) { %>
                                        <% editCatData.forEach(cat => { %>
                                            <option value="<%= cat.name %>" data-size-group="<%= cat.group || 'none' %>">
                                                <%= cat.icon %> <%= cat.name %>
                                            </option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                        <% } else { %>
                            <div class="field">
                                <label>Item Category</label>
                                <select id="editItemCategory" name="item[itemCategory]" class="form-control"
                                    style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:8px;"
                                    required>
                                    <option value="" disabled>Select Category</option>
                                    <% if(typeof currentShopCats !== 'undefined' && currentShopCats) { %>
                                        <% currentShopCats.forEach(cat => { %>
                                            <option value="<%= cat.name %>" data-size-group="<%= cat.group || 'none' %>">
                                                <%= cat.icon %> <%= cat.name %>
                                            </option>
                                        <% }) %>
                                    <% } else { %>
                                        <option value="General">📦 General</option>
                                        <option value="Others">📦 Others</option>
                                    <% } %>
                                </select>
                            </div>
                        <% } %>

                                <% if(shop.category==='Footwear' ) { %>
                                    <div class="field">
                                        <label style="font-weight:700; margin-bottom:10px; display:block;">Available
                                            Sizes</label>

                                        <!-- Kids Infant -->
                                        <div class="size-group" data-size-group="kids-infant">
                                            <div class="size-group-label">👶 Kids – Infant (UK 1–9)</div>
                                            <div class="size-chips">
                                                <% ['1','2','3','4','5','6','7','8','9'].forEach(function(s){ %>
                                                    <span class="size-chip">
                                                        <input type="checkbox" name="item[sizes][]"
                                                            value="Kids-Infant-UK<%= s %>" id="sz_edit_ki_<%= s %>">
                                                        <label for="sz_edit_ki_<%= s %>">UK <%= s %></label>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                        </div>
                                        <!-- Kids Junior -->
                                        <div class="size-group" data-size-group="kids-junior">
                                            <div class="size-group-label">🧒 Kids – Junior (UK 10–3)</div>
                                            <div class="size-chips">
                                                <% ['10','11','12','13','1j','2j','3j'].forEach(function(s){ var
                                                    label=s.endsWith('j') ? 'UK ' +s.replace('j','') : 'UK ' +s; %>
                                                    <span class="size-chip">
                                                        <input type="checkbox" name="item[sizes][]"
                                                            value="Kids-Junior-<%= s %>" id="sz_edit_kj_<%= s %>">
                                                        <label for="sz_edit_kj_<%= s %>">
                                                            <%= label %>
                                                        </label>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                        </div>
                                        <!-- Women (UK 3–11) -->
                                        <div class="size-group" data-size-group="women">
                                            <div class="size-group-label">👠 Women (UK 3–11)</div>
                                            <div class="size-chips">
                                                <% ['3','4','5','6','7','8','9','10','11'].forEach(function(s){ %>
                                                    <span class="size-chip">
                                                        <input type="checkbox" name="item[sizes][]"
                                                            value="Women-UK<%= s %>"
                                                            id="sz_edit_w_<%= s.replace('.','_') %>">
                                                        <label for="sz_edit_w_<%= s.replace('.','_') %>">UK <%= s %>
                                                        </label>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                        </div>
                                        <!-- Men (UK 5–12) -->
                                        <div class="size-group" data-size-group="men">
                                            <div class="size-group-label">👞 Men (UK 5–12)</div>
                                            <div class="size-chips">
                                                <% ['5','6','7','8','9','10','11','12'].forEach(function(s){ %>
                                                    <span class="size-chip">
                                                        <input type="checkbox" name="item[sizes][]"
                                                            value="Men-UK<%= s %>"
                                                            id="sz_edit_m_<%= s.replace('.','_') %>">
                                                        <label for="sz_edit_m_<%= s.replace('.','_') %>">UK <%= s %>
                                                        </label>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>

                                        <!-- Dynamic Fashion Sizes (Edit Item) -->
                                        <div class="field" id="edit-sizes-men" style="display: none;">
                                            <label style="font-weight:700; margin-bottom:10px; display:block;">Men's Sizes</label>
                                            <div class="size-group">
                                                <div class="size-chips">
                                                    <% ['XS','S','M','L','XL','XXL','XXXL', '28','30','32','34','36','38','40'].forEach(function(s){ %>
                                                        <span class="size-chip">
                                                            <input type="checkbox" name="item[sizes][]" value="<%= s %>" id="sz_edit_men_<%= s %>">
                                                            <label for="sz_edit_men_<%= s %>"><%= s %></label>
                                                        </span>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="field" id="edit-sizes-women" style="display: none;">
                                            <label style="font-weight:700; margin-bottom:10px; display:block;">Women's Sizes</label>
                                            <div class="size-group">
                                                <div class="size-chips">
                                                    <% ['XS','S','M','L','XL','XXL', '26','28','30','32','34','36'].forEach(function(s){ %>
                                                        <span class="size-chip">
                                                            <input type="checkbox" name="item[sizes][]" value="<%= s %>" id="sz_edit_wom_<%= s %>">
                                                            <label for="sz_edit_wom_<%= s %>"><%= s %></label>
                                                        </span>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="field" id="edit-sizes-kids" style="display: none;">
                                            <label style="font-weight:700; margin-bottom:10px; display:block;">Kids' Sizes</label>
                                            <div class="size-group">
                                                <div class="size-chips">
                                                    <% ['0-6 months','6-12 months','1-2 years','2-3 years','3-4 years','5-6 years','7-8 years','9-10 years','11-12 years'].forEach(function(s){ %>
                                                        <span class="size-chip">
                                                            <input type="checkbox" name="item[sizes][]" value="<%= s %>" id="sz_edit_kid_<%= s.replace(/ /g, '_') %>">
                                                            <label for="sz_edit_kid_<%= s.replace(/ /g, '_') %>"><%= s %></label>
                                                        </span>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        </div>

                                                <button type="submit" class="btn btn-primary w-100">Update
                                                    Item</button>

                    </form>
                </div>
            </div><!-- /editItemModal -->

            <!-- Delete Confirmation Modal -->
            <div id="deleteModal" class="modal" style="z-index: 1100;">
                <div class="modal-content" style="max-width: 400px; text-align: center; padding: 30px;">
                    <div style="margin-bottom: 20px;">
                        <div
                            style="width: 60px; height: 60px; background: #fee2e2; color: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 24px;">
                            <i class="fa-solid fa-trash-can"></i>
                        </div>
                        <h3 style="font-size: 20px; font-weight: 700; color: #1f2937; margin-bottom: 8px;">Delete
                            Item?
                        </h3>
                        <p style="color: #6b7280; font-size: 15px; line-height: 1.5;">
                            Are you sure you want to delete this item? This action cannot be undone.
                        </p>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <button class="btn"
                            style="background: #f3f4f6; color: #4b5563; border: 1px solid #e5e7eb; width: 100%;"
                            onclick="closeDeleteModal()">
                            Cancel
                        </button>
                        <form id="deleteForm" method="POST" style="margin:0; width: 100%;">

                            <button class="btn btn-danger" style="width: 100%; justify-content: center;">
                                Yes, Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- NEW: Item Detail Modal -->
            <div id="itemModal" class="item-modal">
                <div class="item-modal-card">
                    <button class="item-modal-close" onclick="closeItemModal()">&times;</button>
                    <div class="item-modal-header">
                        <h2 class="item-modal-title" id="modalItemName"></h2>
                    </div>
                    <div class="item-modal-body">
                        <div class="item-modal-img-wrapper" style="background-color: white !important;">
                            <img id="modalItemImage" class="item-modal-img" alt="Item"
                                style="object-fit: contain !important;">
                        </div>
                        <div class="item-modal-desc" id="modalItemDescription"
                            style="padding: 20px; font-size: 15px; color: #475569; line-height: 1.6; background: white;">
                        </div>
                    </div>
                    <div class="item-modal-footer">
                        <div style="display: flex; justify-content: flex-end; margin-bottom: 5px;">
                            <div class="item-modal-price" id="modalItemPrice"></div>
                        </div>
                        <div class="item-modal-footer-buttons">
                            <% if (typeof currUser !=='undefined' && currUser) { %>
                                <div style="display: flex; gap: 10px; width: 100%;">
                                    <button id="modalAddToCartBtn" class="item-modal-action-btn"
                                        style="background: #1e293b; justify-content: center; flex: 1;">
                                        <i class="fa-solid fa-cart-plus"></i> <span class="btn-text">Add to Cart</span>
                                    </button>
                                    <button id="modalOrderNowBtn" class="item-modal-action-btn"
                                        style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); justify-content: center; flex: 1;">
                                        <i class="fa-solid fa-bolt"></i> <span class="btn-text">Buy Now</span>
                                    </button>
                                </div>
                                <% } else { %>
                                    <a href="/alreadyLogin?redirect=/shops/<%= shop._id %>"
                                        class="item-modal-action-btn"
                                        style="background: #1e293b; width: 100%; justify-content: center; text-decoration: none; display: flex; align-items: center;">
                                        Login to Add to Cart
                                    </a>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- UPI Modal -->
            <div id="upiModal" class="modal">
                <div class="modal-content" style="text-align:center;">
                    <span class="close" onclick="closeUpiModal()">&times;</span>
                    <h2 style="margin-bottom:10px;">Scan to Pay</h2>
                    <p class="text-muted small mb-4">Pay directly to the shop owner using any UPI app</p>

                    <!-- Generated QR Code (Priority) -->
                    <% if (shop.upiId) { %>
                        <div id="generated-qr-container" class="mb-4">
                            <div id="shop-qrcode" class="d-inline-block p-2 border rounded bg-white"></div>
                            <div class="mt-2 font-weight-bold text-primary">
                                <%= shop.upiId %>
                            </div>
                        </div>
                        <% } %>

                            <!-- Uploaded QR Image (Fallback/Secondary) -->
                            <% if (shop.upiScanner && shop.upiScanner.url) { %>
                                <div style="margin-bottom:20px;">
                                    <p class="small text-muted mb-2">Shop Owner's Uploaded QR:</p>
                                    <img src="<%= optimizeImage(shop.upiScanner.url) %>" alt="UPI QR Code"
                                        style="max-width:100%; border-radius:12px; border:1px solid #e5e7eb;">

                                    <% if (currUser && shop.owner._id.equals(currUser._id)) { %>
                                        <form action="/shops/<%= shop._id %>/upi?_method=DELETE" method="POST"
                                            class="mt-2">
                                            <button class="btn btn-sm btn-outline-danger">Delete QR</button>
                                        </form>
                                        <% } %>
                                </div>
                                <% } %>
                </div>
            </div>

            <!-- Shop QR Modal -->
            <div id="shopQrModal" class="modal">
                <div class="modal-content text-center" style="max-width: 400px;">
                    <span class="close" onclick="closeShopQrModal()">&times;</span>
                    <h2 class="mb-1" style="font-weight: 800;">Store QR Code</h2>
                    <p class="text-muted small mb-4">Anyone who scans this will be taken directly to your shop and its
                        items.</p>

                    <div id="shop-qr-main" class="d-inline-block p-4 bg-white border rounded-4 mb-4"
                        style="box-shadow: 0 10px 25px rgba(0,0,0,0.05); min-width: 256px; min-height: 256px;"></div>

                    <div class="text-center">
                        <h4 style="font-weight: 700; color: var(--text); margin-bottom: 5px;">
                            <%= shop.shopName %>
                        </h4>
                        <p class="text-muted mb-4" style="font-size: 0.85rem;">
                            <%= shop.location %>
                        </p>
                    </div>

                    <% if (currUser && shop.owner._id.equals(currUser._id)) { %>
                        <button class="btn btn-primary w-100 py-3" onclick="downloadShopQr()"
                            style="border-radius: 12px; font-weight: 700;">
                            <i class="fa-solid fa-download me-2"></i> Download QR Image
                        </button>
                        <% } %>
                </div>
            </div>

            <script>
                // NEW: Open Item Modal
                function openItemModal(element) {
                    const name = element.getAttribute('data-name');
                    const imgUrl = element.getAttribute('data-img');
                    const price = element.getAttribute('data-price');
                    const itemId = element.getAttribute('data-itemid');
                    const shopId = element.getAttribute('data-shopid');
                    const shopName = element.getAttribute('data-shopname');
                    const description = element.getAttribute('data-description');

                    const modal = document.getElementById('itemModal');
                    const nameEl = document.getElementById('modalItemName');
                    const imgEl = document.getElementById('modalItemImage');
                    const priceEl = document.getElementById('modalItemPrice');

                    nameEl.textContent = name;
                    imgEl.src = imgUrl || '/images/placeholder.jpg';
                    priceEl.textContent = '₹' + price;

                    const addBtn = document.getElementById('modalAddToCartBtn');
                    if (addBtn) {
                        addBtn.setAttribute('data-itemid', itemId);
                        addBtn.setAttribute('data-name', name);
                        addBtn.setAttribute('data-img', imgUrl);
                        addBtn.setAttribute('data-price', price);
                        addBtn.setAttribute('data-shopid', shopId);
                        addBtn.setAttribute('data-shopname', shopName);
                    }

                    const orderBtn = document.getElementById('modalOrderNowBtn');
                    if (orderBtn) {
                        orderBtn.setAttribute('data-itemid', itemId);
                        orderBtn.setAttribute('data-name', name);
                        orderBtn.setAttribute('data-img', imgUrl);
                        orderBtn.setAttribute('data-price', price);
                        orderBtn.setAttribute('data-shopid', shopId);
                        orderBtn.setAttribute('data-shopname', shopName);
                    }

                    modal.style.display = 'flex';
                }

                // Attach event listeners outside the open function to prevent duplicate bindings or closures capturing old variables
                document.getElementById('modalAddToCartBtn')?.addEventListener('click', async function () {
                    const btn = this;
                    const originalHtml = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Adding...';
                    btn.disabled = true;

                    const success = await addToCart(
                        btn.getAttribute('data-itemid'),
                        btn.getAttribute('data-name'),
                        btn.getAttribute('data-img'),
                        btn.getAttribute('data-price'),
                        btn.getAttribute('data-shopid'),
                        btn.getAttribute('data-shopname')
                    );

                    if (!success) {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }
                });

                document.getElementById('modalOrderNowBtn')?.addEventListener('click', async function () {
                    const btn = this;
                    const originalHtml = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';
                    btn.disabled = true;

                    const success = await orderNow(
                        btn.getAttribute('data-itemid'),
                        btn.getAttribute('data-name'),
                        btn.getAttribute('data-img'),
                        btn.getAttribute('data-price'),
                        btn.getAttribute('data-shopid'),
                        btn.getAttribute('data-shopname')
                    );
                    
                    if (!success) {
                        btn.innerHTML = originalHtml;
                        btn.disabled = false;
                    }
                });

                async function addToCart(itemId, name, imgUrl, price, shopId, shopName, silent = false) {
                    try {
                        const res = await fetch('/api/cart/add', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ itemId, itemName: name, itemImage: imgUrl, price, shopId, shopName })
                        });


                        const data = await res.json();
                        if (res.ok) {
                            if (!silent) {
                                showToast("Success! Item added to your cart.", 'success');
                                const btn = document.getElementById('modalAddToCartBtn');
                                if(btn) {
                                    btn.innerHTML = '<i class="fa-solid fa-check"></i> Added!';
                                    btn.style.background = '#16a34a'; // Green success color
                                    setTimeout(() => {
                                        btn.innerHTML = '<i class="fa-solid fa-cart-plus"></i> <span class="btn-text">Add to Cart</span>';
                                        btn.style.background = '#1e293b'; 
                                        btn.disabled = false;
                                        closeItemModal();
                                    }, 800);
                                }
                                
                                // Best effort dynamic navbar cart update
                                const cartBages = document.querySelectorAll('.bg-danger.rounded-pill, .bg-danger.border-light.rounded-circle');
                                cartBages.forEach(badge => {
                                    if(badge.classList.contains('rounded-pill')) {
                                        let count = parseInt(badge.innerText) || 0;
                                        badge.innerText = count + 1;
                                    }
                                });
                            }
                            return true;
                        } else {
                            if (res.status === 401) {
                                if (typeof window.showLoginModal === 'function') {
                                    window.showLoginModal();
                                } else {
                                    window.location.href = '/login';
                                }
                            } else {
                                showToast(data.message || "Failed to add to cart", 'danger');
                            }
                            return false;
                        }
                    } catch (e) {
                        console.error(e);
                        showToast("Error adding to cart", 'danger');
                        return false;
                    }
                }

                function orderNow(itemId, name, imgUrl, price, shopId, shopName) {
                    return addToCart(itemId, name, imgUrl, price, shopId, shopName, true).then((success) => {
                        if (success) window.location.href = '/api/cart';
                        return success;
                    });
                }

                function closeItemModal() {
                    document.getElementById('itemModal').style.display = 'none';
                }

                function openUpiModal() {
                    document.getElementById('upiModal').style.display = 'block';

                    // Generate QR if upiId exists and not already generated
                    setTimeout(() => {
                        const upiId = "<%= shop.upiId %>";
                        const qrDiv = document.getElementById('shop-qrcode');
                        if (upiId && qrDiv && qrDiv.innerHTML.trim() === "") {
                            new QRCode(qrDiv, {
                                text: `upi://pay?pa=${upiId}&pn=<%= shop.shopName.replace(/\s/g, '%20') %>&cu=INR`,
                                width: 200,
                                height: 200,
                                colorDark: "#000000",
                                colorLight: "#ffffff",
                                correctLevel: QRCode.CorrectLevel.H
                            });

                            setTimeout(() => {
                                const canvas = qrDiv.querySelector('canvas');
                                if (canvas) {
                                    const ctx = canvas.getContext('2d');
                                    const logoImg = new Image();
                                    logoImg.crossOrigin = "Anonymous";
                                    logoImg.src = '/images/icon.jpeg'; 
                                    logoImg.onload = () => {
                                        const logoSize = 50; 
                                        const x = (canvas.width - logoSize) / 2;
                                        const y = (canvas.height - logoSize) / 2;
                                        
                                        ctx.beginPath();
                                        ctx.arc(canvas.width/2, canvas.height/2, logoSize/2 + 6, 0, 2 * Math.PI);
                                        ctx.fillStyle = '#ffffff';
                                        ctx.fill();

                                        ctx.save();
                                        ctx.beginPath();
                                        ctx.arc(canvas.width/2, canvas.height/2, logoSize/2, 0, 2 * Math.PI);
                                        ctx.clip();
                                        ctx.drawImage(logoImg, x, y, logoSize, logoSize);
                                        ctx.restore();
                                        
                                        const qrImg = qrDiv.querySelector('img');
                                        if (qrImg) qrImg.src = canvas.toDataURL("image/png");
                                    };
                                }
                            }, 100);
                        }
                    }, 50);
                }

                function closeUpiModal() {
                    document.getElementById('upiModal').style.display = 'none';
                }

                // Shop Profile QR Logic
                function openShopQrModal() {
                    const modal = document.getElementById('shopQrModal');
                    const qrContainer = document.getElementById('shop-qr-main');
                    modal.style.display = 'block';

                    // Use setTimeout to ensure the modal is visible before generating QR
                    setTimeout(() => {
                        if (qrContainer && qrContainer.innerHTML.trim() === "") {
                            try {
                                if (typeof QRCode === 'undefined') {
                                    qrContainer.innerHTML = '<p class="text-danger small">QR Library not loaded</p>';
                                    return;
                                }

                                const shopUrl = window.location.origin + window.location.pathname; // Direct link to this shop
                                new QRCode(qrContainer, {
                                    text: shopUrl,
                                    width: 256,
                                    height: 256,
                                    colorDark: "#0F172A",
                                    colorLight: "#ffffff",
                                    correctLevel: QRCode.CorrectLevel.H
                                });

                                setTimeout(() => {
                                    const canvas = qrContainer.querySelector('canvas');
                                    if (canvas) {
                                        const ctx = canvas.getContext('2d');
                                        const logoImg = new Image();
                                        logoImg.crossOrigin = "Anonymous";
                                        logoImg.src = '/images/icon.jpeg'; 
                                        logoImg.onload = () => {
                                            const logoSize = 64; 
                                            const x = (canvas.width - logoSize) / 2;
                                            const y = (canvas.height - logoSize) / 2;
                                            
                                            ctx.beginPath();
                                            ctx.arc(canvas.width/2, canvas.height/2, logoSize/2 + 6, 0, 2 * Math.PI);
                                            ctx.fillStyle = '#ffffff';
                                            ctx.fill();

                                            ctx.save();
                                            ctx.beginPath();
                                            ctx.arc(canvas.width/2, canvas.height/2, logoSize/2, 0, 2 * Math.PI);
                                            ctx.clip();
                                            ctx.drawImage(logoImg, x, y, logoSize, logoSize);
                                            ctx.restore();
                                            
                                            const qrImg = qrContainer.querySelector('img');
                                            if (qrImg) qrImg.src = canvas.toDataURL("image/png");
                                        };
                                    }
                                }, 100);
                            } catch (err) {
                                console.error("QR Generation Error:", err);
                                qrContainer.innerHTML = '<p class="text-danger small">Failed to generate QR</p>';
                            }
                        }
                    }, 50);
                }

                function closeShopQrModal() {
                    document.getElementById('shopQrModal').style.display = 'none';
                }

                function downloadShopQr() {
                    const qrContainer = document.getElementById('shop-qr-main');
                    const canvas = qrContainer.querySelector('canvas');
                    if (!canvas) return;

                    const link = document.createElement('a');
                    link.download = `<%= shop.shopName.replace(/\s+/g, '_') %>_Store_QR.png`;
                    link.href = canvas.toDataURL("image/png");
                    link.click();
                }

                // Close modals when clicking outside
                window.addEventListener('click', function (event) {
                    const itemModal = document.getElementById('itemModal');
                    const addModal = document.getElementById('addItemModal');
                    const deleteModal = document.getElementById('deleteModal');
                    const upiModal = document.getElementById('upiModal');
                    const shopQrModal = document.getElementById('shopQrModal');

                    if (event.target === itemModal) closeItemModal();
                    if (event.target === addModal) addModal.style.display = 'none';
                    if (event.target === deleteModal) deleteModal.style.display = 'none';
                    if (event.target === upiModal) closeUpiModal();
                    if (event.target === shopQrModal) closeShopQrModal();
                });
            </script>

            <!-- Script for gallery/share same as productDetail -->
            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    // Modal Logic
                    const modal = document.getElementById("addItemModal");
                    const btn = document.getElementById("addItemBtn");
                    const span = document.getElementsByClassName("close")[0];

