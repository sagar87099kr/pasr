        function getShopCategoryData(shopCategory) { 
            if (!shopCategory) return null; 
            const sc = shopCategory.toString().trim().toLowerCase();
            const key = Object.keys(SHOP_CATEGORIES).find(function(k) { 
                const tk = k.trim().toLowerCase();
                return tk === sc || (tk === 'footwear' && sc === 'footwears') || (tk === 'fashion' && sc === 'fashions');
            }); 
            return key ? SHOP_CATEGORIES[key] : null; 
        } 
