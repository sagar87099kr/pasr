                                                            <input type="checkbox" name="item[sizes][]" value="<%= s %>" id="sz_add_wom_<%= s %>">
                                                            <label for="sz_add_wom_<%= s %>"><%= s %></label>
                                                        </span>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="field" id="add-sizes-kids" style="display: none;">
                                            <label style="font-weight:700; margin-bottom:10px; display:block;">Kids' Sizes</label>
                                            <div class="size-group">
                                                <div class="size-chips">
                                                    <% ['0-6 months','6-12 months','1-2 years','2-3 years','3-4 years','5-6 years','7-8 years','9-10 years','11-12 years'].forEach(function(s){ %>
                                                        <span class="size-chip">
                                                            <input type="checkbox" name="item[sizes][]" value="<%= s %>" id="sz_add_kid_<%= s.replace(/ /g, '_') %>">
                                                            <label for="sz_add_kid_<%= s.replace(/ /g, '_') %>"><%= s %></label>
                                                        </span>
                                                    <% }); %>
                                                </div>
                                            </div>
                                        </div>


                                                <button class="btn btn-primary w-100" id="addItemSubmitBtn">Add
                                                    Item</button>


                    </form>
                </div>
            </div>

            <!-- Edit Item Modal -->
            <div id="editItemModal" class="modal">
                <div class="modal-content">
                    <span class="close" onclick="closeEditItemModal()">&times;</span>
                    <h2 style="margin-bottom:20px;">Edit Item</h2>
                    <form id="editItemForm" method="POST" enctype="multipart/form-data" class="review-form">

                        <input type="hidden" id="editItemId" name="itemId">
                        <input type="hidden" id="editProductId" name="productId">
                        <!-- 1. Item Name -->
                        <div class="field" style="position: relative;">
                            <label>Item Name</label>
                            <input type="text" id="editItemName" name="item[name]" required
                                placeholder="Enter item name" autocomplete="off"
                                style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:8px;">
                        </div>
                        
                        <!-- 2. Item Image Upload & Preview -->
                        <div class="field" id="editItemImageField">
                            <label>Update Image (Optional)</label>
                            <input type="file" name="itemImage" id="editItemImageInput" accept="image/*"
                                style="width:100%; padding:10px; background:#f9fafb; border:1px solid #d1d5db; border-radius:8px;">
                            
                            <div id="editFilePreviewContainer" style="display: none; margin-top: 10px; text-align: center;">
