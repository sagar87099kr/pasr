                                                        <input type="checkbox" name="item[sizes][]"
                                                            value="Kids-Junior-<%= id %>" id="sz_add_kj_<%= id %>">
                                                        <label for="sz_add_kj_<%= id %>">
                                                            <%= label %>
                                                        </label>
                                                    </span>
                                                    <% }); %>
                                            </div>
                                        </div>

                                        <!-- Women (UK 3–11) -->
                                        <div class="size-group" data-size-group="women">
                                            <div class="size-group-label">👠 Women (UK 3–11)</div>
                                            <div class="size-chips">
