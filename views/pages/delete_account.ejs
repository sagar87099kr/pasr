<% layout('layoutes/boilerplate') %>

<style>
    .delete-container {
        max-width: 500px;
        margin: 60px auto;
        padding: 40px 30px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border-top: 5px solid #dc2626;
    }
    .delete-container h2 {
        color: #dc2626;
        font-weight: 800;
        margin-bottom: 20px;
        text-align: center;
    }
    .delete-container p {
        color: #4b5563;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 30px;
        text-align: center;
    }
    .warning-box {
        background: #fef2f2;
        border: 1px solid #f87171;
        padding: 15px;
        border-radius: 8px;
        color: #991b1b;
        font-size: 0.85rem;
        margin-bottom: 25px;
    }
    .form-group label {
        font-weight: 700;
        color: #374151;
        margin-bottom: 8px;
    }
    .form-control {
        border-radius: 8px;
        padding: 12px 15px;
        border: 1px solid #d1d5db;
        margin-bottom: 20px;
    }
    .form-control:focus {
        border-color: #dc2626;
        box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
    }
    .btn-delete {
        background: #dc2626;
        color: white;
        font-weight: 700;
        padding: 14px;
        border-radius: 8px;
        width: 100%;
        border: none;
        transition: background 0.3s;
    }
    .btn-delete:hover {
        background: #b91c1c;
    }
</style>

<div class="container">
    <div class="delete-container">
        <h2><i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Account</h2>
        
        <p>This action is <strong>permanent</strong> and cannot be undone. All your details, shops, local bazaar listings, referrals, and provider pages will be permanently destroyed.</p>

        <div class="warning-box">
            <strong>Warning:</strong> You will completely lose access to your PaSr account. Your phone number will be freed, meaning you can sign up again as a completely new user.
        </div>

        <form action="/account/remove/permanent" method="POST">
            <div class="form-group">
                <label for="username">Registered Mobile Number</label>
                <input type="tel" class="form-control" id="username" name="username" placeholder="Enter your 10-digit number" pattern="[0-9]{10}" required>
            </div>

            <div class="form-group">
                <label for="password">Account Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required>
            </div>

            <div class="form-check mb-4" style="text-align: left;">
                <input type="checkbox" class="form-check-input" id="confirmCheckbox" required>
                <label class="form-check-label text-muted" style="font-size: 0.85rem;" for="confirmCheckbox">
                    I understand that deleting my account is completely irreversible.
                </label>
            </div>

            <button type="submit" class="btn-delete">
                <i class="fa-solid fa-trash me-2"></i> Permanently Delete My Account
            </button>
        </form>
    </div>
</div>
