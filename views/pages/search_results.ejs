<% layout('./layoutes/boilerplate.ejs', { containerClass: 'search-results-page-container' }) -%>

    <head>
        <link rel="stylesheet" href="/css/search_results.css">
    </head>

    <div class="search-results-page-wrapper">
        <!-- Hero Section -->
        <section class="search-results-hero">
            <h1>Discovery</h1>
            <p>
                <% if (query) { %>
                    Search results for <span class="search-query-pill">"<%= query %>"</span>
                    <% } else { %>
                        Finding the best local services and products for you.
                        <% } %>
            </p>
        </section>

        <!-- Service Providers -->
        <% if (providers && providers.length> 0) { %>
            <div class="section-title-wrap">
                <h2>Service Providers</h2>
            </div>
            <div class="search-results-grid">
                <% for (let provider of providers) { %>
                    <a href="/provider/<%= provider._id %>/profile" class="search-avatar-card">
                        <div class="avatar-circle-wrapper"
                            style="width: 150px; height: 150px; border-radius: 50%; overflow: hidden; margin: 0 auto 1.5rem; border: 4px solid #f1f5f9; box-shadow: 0 4px 10px rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: center; background: #f8fafc;">
                            <% if(provider.personImage && provider.personImage.length> 0) { %>
                                <img src="<%= provider.personImage[0].path %>"
                                    style="width: 100%; height: 100%; object-fit: cover;" alt="Provider">
                                <% } else { %>
                                    <img src="https://via.placeholder.com/150?text=Provider"
                                        style="width: 100%; height: 100%; object-fit: cover;" alt="No image">
                                    <% } %>
                        </div>
                        <div class="info-content-main">
                            <h5 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">
                                <%= provider.company %>
                            </h5>
                            <p
                                style="font-size: 0.9rem; color: #64748b; margin-bottom: 1rem; display: flex; align-items: center; gap: 5px; justify-content: center;">
                                <i class="fa-solid fa-location-dot"></i>
                                <%= provider.location %>
                            </p>
                            <div class="result-footer"
                                style="display: flex; justify-content: center; gap: 10px; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 1rem; width: 100%;">
                                <span class="badge-tag tag-provider">Provider</span>
                                <% if(provider.categories) { %>
                                    <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">
                                        <%= provider.categories %>
                                    </span>
                                    <% } %>
                            </div>
                        </div>
                    </a>
                    <% } %>
            </div>
            <% } %>

                <!-- Local Shops -->
                <% if (shops && shops.length> 0) { %>
                    <div class="section-title-wrap">
                        <h2>Local Shops</h2>
                    </div>
                    <div class="search-results-grid">
                        <% for (let shop of shops) { %>
                            <a href="/shops/<%= shop._id %>" class="search-avatar-card">
                                <div class="avatar-circle-wrapper"
                                    style="width: 150px; height: 150px; border-radius: 50%; overflow: hidden; margin: 0 auto 1.5rem; border: 4px solid #f1f5f9; box-shadow: 0 4px 10px rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: center; background: #f8fafc;">
                                    <% if(shop.shopImage && shop.shopImage.length> 0) { %>
                                        <img src="<%= typeof optimizeImage === 'function' ? optimizeImage(shop.shopImage[0].url) : shop.shopImage[0].url %>"
                                            style="width: 100%; height: 100%; object-fit: cover;" alt="Shop">
                                        <% } else { %>
                                            <img src="https://via.placeholder.com/150?text=Shop"
                                                style="width: 100%; height: 100%; object-fit: cover;" alt="No image">
                                            <% } %>
                                </div>
                                <div class="info-content-main">
                                    <h5
                                        style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem;">
                                        <%= shop.shopName %>
                                    </h5>
                                    <p
                                        style="font-size: 0.9rem; color: #64748b; margin-bottom: 1rem; display: flex; align-items: center; gap: 5px; justify-content: center;">
                                        <i class="fa-solid fa-location-dot"></i>
                                        <%= shop.location %>
                                    </p>
                                    <div class="result-footer"
                                        style="display: flex; justify-content: center; gap: 10px; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 1rem; width: 100%;">
                                        <span class="badge-tag tag-shop">Local Shop</span>
                                        <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">
                                            <%= shop.category %>
                                        </span>
                                    </div>
                                </div>
                            </a>
                            <% } %>
                    </div>
                    <% } %>

                        <!-- Shop Items -->
                        <% if (typeof items !== 'undefined' && items && items.length > 0) { %>
                            <div class="section-title-wrap">
                                <h2>Shop Items</h2>
                            </div>
                            <div class="search-results-grid">
                                <% for (let item of items) { %>
                                    <% if (item.shop) { %>
                                    <a href="/shops/<%= item.shop._id %>" class="search-avatar-card">
                                        <div class="avatar-circle-wrapper"
                                            style="width: 150px; height: 150px; border-radius: 50%; overflow: hidden; margin: 0 auto 1.5rem; border: 4px solid #f1f5f9; box-shadow: 0 4px 10px rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: center; background: #f8fafc;">
                                            <% if(item.img && item.img.url) { %>
                                                <img src="<%= typeof optimizeImage === 'function' ? optimizeImage(item.img.url) : item.img.url %>"
                                                    style="width: 100%; height: 100%; object-fit: cover;" alt="Item">
                                            <% } else { %>
                                                <img src="https://via.placeholder.com/150?text=Item"
                                                    style="width: 100%; height: 100%; object-fit: cover;"
                                                    alt="No image">
                                            <% } %>
                                        </div>
                                        <div class="info-content-main">
                                            <h5
                                                style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 250px;">
                                                <%= item.name || 'Unnamed Item' %>
                                            </h5>
                                            <p
                                                style="font-size: 0.9rem; color: #64748b; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 5px; justify-content: center;">
                                                <i class="fa-solid fa-store"></i>
                                                <%= item.shop.shopName %>
                                            </p>
                                            <p
                                                style="font-size: 0.8rem; color: #94a3b8; margin-bottom: 1rem; display: flex; align-items: center; gap: 5px; justify-content: center;">
                                                <i class="fa-solid fa-location-dot"></i>
                                                <%= item.shop.location %>
                                            </p>
                                            <div class="result-footer"
                                                style="display: flex; justify-content: center; gap: 10px; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 1rem; width: 100%;">
                                                <span class="badge-tag tag-product">Item</span>
                                                <span class="price-tag" style="font-weight: 800; color: #16a34a;">₹<%= item.price %></span>
                                            </div>
                                        </div>
                                    </a>
                                    <% } %>
                                <% } %>
                            </div>
                        <% } %>

                        <!-- Products -->
                        <% if (products && products.length> 0) { %>
                            <div class="section-title-wrap">
                                <h2>Direct Products</h2>
                            </div>
                            <div class="search-results-grid">
                                <% for (let product of products) { %>
                                    <a href="/products/<%= product._id %>" class="search-avatar-card">
                                        <div class="avatar-circle-wrapper"
                                            style="width: 150px; height: 150px; border-radius: 50%; overflow: hidden; margin: 0 auto 1.5rem; border: 4px solid #f1f5f9; box-shadow: 0 4px 10px rgba(0,0,0,0.1); display: flex; align-items: center; justify-content: center; background: #f8fafc;">
                                            <% if(product.productImage && product.productImage.length> 0) { %>
                                                <img src="<%= product.productImage[0].url %>"
                                                    style="width: 100%; height: 100%; object-fit: cover;" alt="Product">
                                                <% } else { %>
                                                    <img src="https://via.placeholder.com/150?text=Product"
                                                        style="width: 100%; height: 100%; object-fit: cover;"
                                                        alt="No image">
                                                    <% } %>
                                        </div>
                                        <div class="info-content-main">
                                            <h5
                                                style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 250px;">
                                                <%= product.productName %>
                                            </h5>
                                            <p
                                                style="font-size: 0.9rem; color: #64748b; margin-bottom: 1rem; display: flex; align-items: center; gap: 5px; justify-content: center;">
                                                <i class="fa-solid fa-location-dot"></i>
                                                <%= product.location %>
                                            </p>
                                            <div class="result-footer"
                                                style="display: flex; justify-content: center; gap: 10px; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 1rem; width: 100%;">
                                                <span class="badge-tag tag-product">Product</span>
                                                <span class="price-tag" style="font-weight: 800; color: #16a34a;">₹<%=
                                                        product.price %></span>
                                            </div>
                                        </div>
                                    </a>
                                    <% } %>
                            </div>
                            <% } %>

                                <!-- No Results -->
                                <% if ((!providers || providers.length==0) && (!shops || shops.length==0) && (!products
                                    || products.length==0) && (typeof items === 'undefined' || !items || items.length==0)) { %>
                                    <div class="empty-search-container">
                                        <div class="empty-search-icon">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </div>
                                        <h3>No results found</h3>
                                        <p class="text-muted">We couldn't find anything matching your search. Please try
                                            different keywords.</p>
                                        <a href="/home" class="btn btn-primary rounded-pill px-4 py-2 mt-3">Back to
                                            Home</a>
                                    </div>
                                    <% } %>
    </div>