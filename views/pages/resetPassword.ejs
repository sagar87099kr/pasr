<% layout('./layoutes/boilerplate.ejs') -%>
    <link rel="stylesheet" href="/css/auth.css">

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Set New Password</h1>
                <p class="auth-subtitle">Choose a strong new password for your account.</p>
            </div>

            <form action="/reset-password/<%= token %>" method="POST" novalidate class="needs-validation">
                <div class="form-group">
                    <label for="newPassword" class="form-label">New Password *</label>
                    <input type="password" class="form-control" id="newPassword" name="password"
                        placeholder="Enter new password (min 6 chars)" required minlength="6">
                    <div class="invalid-feedback">Password must be at least 6 characters.</div>
                </div>

                <div class="form-group" style="margin-bottom:28px;">
                    <label for="confirmPassword" class="form-label">Confirm Password *</label>
                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                        placeholder="Re-enter your password" required>
                    <div class="invalid-feedback">Please confirm your password.</div>
                </div>

                <button class="btn-submit" type="submit">
                    <i class="fa-solid fa-lock"></i> Update Password
                </button>
            </form>

            <script>
                // Client-side password match check
                document.querySelector('form').addEventListener('submit', function (e) {
                    const pw = document.getElementById('newPassword').value;
                    const cpw = document.getElementById('confirmPassword').value;
                    if (pw !== cpw) {
                        e.preventDefault();
                        document.getElementById('confirmPassword').setCustomValidity('Passwords do not match');
                        document.querySelector('form').classList.add('was-validated');
                    } else {
                        document.getElementById('confirmPassword').setCustomValidity('');
                    }
                });
            </script>
        </div>
    </div>