<% layout('/layoutes/boilerplate') -%>

    <style>
        .admin-payouts {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 1rem !important;
        }

        .payout-card {
            border-radius: 12px;
            transition: transform 0.2s;
        }

        .payout-card:hover {
            transform: translateY(-5px);
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }

        .status-success {
            background-color: #d4edda;
            color: #155724;
        }
    </style>

    <div class="admin-payouts w-100 mt-4 mb-5">
        <div class="row mb-4 align-items-center">
            <div class="col-md-6">
                <h2 class="fw-bold"><i class="fa-solid fa-money-bill-transfer text-success me-2"></i> Payout Requests
                </h2>
                <p class="text-muted">Manage shop owner payout requests here. (Restricted to 8709956547)</p>
            </div>
            <div class="col-md-6 text-md-end">
                <button class="btn btn-outline-secondary" onclick="window.location.reload()">
                    <i class="fa-solid fa-rotate-right"></i> Refresh
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold mb-0">Pending Payouts</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Date</th>
                                <th>Shop</th>
                                <th>UPI ID</th>
                                <th>Amount</th>
                                <th>Orders Count</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (requests && requests.length> 0) { %>
                                <% requests.forEach(req=> { %>
                                    <tr id="payout-row-<%= req._id %>">
                                        <td class="ps-3">
                                            <%= new Date(req.createdAt).toLocaleDateString('en-IN') %>
                                        </td>
                                        <td>
                                            <div class="fw-bold">
                                                <%= req.shopId ? req.shopId.shopName : 'Unknown' %>
                                            </div>
                                            <div class="text-muted small">ID: <%= req.shopId ? req.shopId._id : 'N/A' %>
                                            </div>
                                        </td>
                                        <td>
                                            <code><%= req.metadata ? req.metadata.upiId : 'N/A' %></code>
                                            <button class="btn btn-sm btn-link"
                                                onclick="navigator.clipboard.writeText('<%= req.metadata.upiId %>')">
                                                <i class="fa-regular fa-copy"></i>
                                            </button>
                                        </td>
                                        <td class="fw-bold text-success">₹<%= req.amount %>
                                        </td>
                                        <td>
                                            <%= req.metadata && req.metadata.ordersSettled ?
                                                req.metadata.ordersSettled.length : 0 %>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-success btn-sm btn-approve" data-id="<%= req._id %>">
                                                Mark as Paid
                                            </button>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">
                                                    <i class="fa-solid fa-check-circle fs-2 mb-2"></i>
                                                    <p>No pending payout requests!</p>
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.btn-approve').forEach(btn => {
            btn.addEventListener('click', async function () {
                const id = this.getAttribute('data-id');
                if (!confirm('Are you sure you have manually transferred the money to this UPI ID?')) return;

                try {
                    const res = await fetch(`/admin/payouts/${id}/approve`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();

                    if (data.success) {
                        document.getElementById(`payout-row-${id}`).remove();
                        alert('Payout marked as settled successfully!');
                    } else {
                        alert(data.message || 'Failed to approve payout.');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error processing request.');
                }
            });
        });
    </script>