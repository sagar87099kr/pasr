<% layout('./layoutes/boilerplate.ejs') -%>
    <link rel="stylesheet" href="/css/auth.css">

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1 class="auth-title">Forgot Password?</h1>
                <p class="auth-subtitle">Enter your registered WhatsApp number and we'll send you a reset link.</p>
            </div>

            <form action="/forgot-password" method="POST" novalidate class="needs-validation">

                <div class="form-group" style="margin-bottom: 28px;">
                    <label for="whatsappNumber" class="form-label">WhatsApp Number *</label>
                    <div style="position:relative;">
                        <span
                            style="position:absolute; left:14px; top:50%; transform:translateY(-50%); font-size:20px; line-height:1;">📱</span>
                        <input type="number" class="form-control" id="whatsappNumber" name="username"
                            placeholder="e.g. 9876543210" required style="padding-left: 44px;">
                    </div>
                    <div class="invalid-feedback">Please enter your 10-digit WhatsApp number.</div>
                </div>

                <button class="btn-submit" type="submit">
                    <i class="fa-brands fa-whatsapp"></i> Send Reset Link
                </button>
            </form>

            <p style="text-align:center; margin-top:20px; font-size:14px; color:#6b7280;">
                Remembered your password?
                <a href="/alreadyLogin" style="color:#138808; font-weight:600; text-decoration:none;">Log In</a>
            </p>
        </div>
    </div>